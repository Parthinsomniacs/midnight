      var frame = document.getElementById("seFrame");
      var media = document.getElementById("seMedia");
      var titleEl = document.getElementById("seTitle");
      var scrim = document.getElementById("seScrim");

      if (!track || !stage || !frame || !media) return;

      // Config
      var startWidth = 55;
      var startHeight = 80;
      var startRadius = 24;
      var endRadius = 0;
      var mediaZoom = 1.15;
      var scrollDistance = 0.25;
      var holdDistance = 0;
      var smoothing = 0.12;
      var overlayScrim = 0.45;

      var current = 0;
      var target = 0;
      var stageH = 0;
      var raf = 0;
      var running = false;

      function clamp(v, a, b) {
        return v < a ? a : v > b ? b : v;
      }
      function smoothstep(edge0, edge1, x) {
        var t = clamp((x - edge0) / (edge1 - edge0 || 1e-6), 0, 1);
        return t * t * (3 - 2 * t);
      }

      function applyProgress(p) {
        var e = smoothstep(0, 1, p);
        var w = startWidth + (100 - startWidth) * e;
        var h = startHeight + (100 - startHeight) * e;
        var ix = Math.max(0, (100 - w) / 2);
        var iy = Math.max(0, (100 - h) / 2);
        var r = startRadius + (endRadius - startRadius) * e;

        frame.style.clipPath =
          "inset(" +
          iy +
          "% " +
          ix +
          "% " +
          iy +
          "% " +
          ix +
          "% round " +
          r +
          "px)";
        media.style.transform =
          "scale(" + (mediaZoom + (1 - mediaZoom) * e) + ")";

        if (scrim) scrim.style.opacity = "" + overlayScrim * e;

        if (titleEl) {
          var out = smoothstep(0.4, 0.88, p);
          titleEl.style.opacity = "" + (1 - out);
          titleEl.style.transform =
            "translate3d(0, " +
            -28 * out +
            "px, 0) scale(" +
            (1 + 0.06 * out) +
            ")";
        }
      }

      function measure() {
        stageH = window.innerHeight;
        if (stageH <= 0) return;
        stage.style.height = stageH + "px";
        track.style.height =
          stageH *
            (1 + Math.max(0, scrollDistance) + Math.max(0, holdDistance)) +
          "px";
        var w = stage.clientWidth || stageH;
        stage.style.setProperty(
          "--se-title-size",
          clamp(w * 0.075, 20, 84) + "px",
        );
      }

      function readProgress() {
        var span = stageH * Math.max(0.01, scrollDistance);
        var top = track.getBoundingClientRect().top;
        return clamp(-top / span, 0, 1);
      }

      function tick() {
        var k = smoothing <= 0 ? 1 : 1 - Math.exp(-1 / (60 * smoothing));
        current += (target - current) * k;
        if (Math.abs(target - current) < 0.0004) {
          current = target;
          running = false;
        }
        applyProgress(current);
        raf = running ? requestAnimationFrame(tick) : 0;
      }

      function kick() {
        if (running) return;
        running = true;
        if (!raf) raf = requestAnimationFrame(tick);
      }

      function onScroll() {
        target = readProgress();
        if (smoothing <= 0) {
          current = target;
          applyProgress(current);
          return;
        }
        kick();
      }

      function onResize() {
        measure();
        target = readProgress();
        current = target;
        applyProgress(current);
      }

      measure();
      target = readProgress();
      current = target;
      applyProgress(current);

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onResize);
      new ResizeObserver(onResize).observe(stage);
    })();
  </script>

  <!-- Service Cards Sticky Animation -->
  <script is:inline>
    /**
     * Service Cards Scroll Animation
     *
     * Approach: GSAP ScrollTrigger with pin.
     * - Cards stacked via position: absolute
     * - Current card scales down + rotates as it exits
     * - Next card slides up from below (yPercent: 100 → 0)
     *
     * Performance optimizations:
     * - scrub: true (no additional smoothing — Lenis already handles it)
     * - force3D: true on all animated elements (GPU compositing)
     * - Only transform + opacity animated (no layout properties)
     * - will-change set via CSS, cleared is unnecessary here since cards persist
     */
    (function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      gsap.registerPlugin(ScrollTrigger);

      var wrapper = document.querySelector(".service-cards-stack");
      var cards = gsap.utils.toArray(".service-cards-stack .svc-card");
      var totalCards = cards.length;
      if (!totalCards || !wrapper) return;

      // Set z-index stacking order and initial positions
      // force3D promotes each card to its own GPU layer
      cards.forEach(function (card, i) {
        card.style.zIndex = i;
        gsap.set(card, {
          yPercent: i === 0 ? 0 : 100,
          force3D: true,
        });
      });

      // Pin the container and create scroll-linked timeline
      // scrub: true = direct 1:1 mapping with scroll (no additional easing)
      // Lenis already provides smooth scroll interpolation (duration: 2)
      // Adding scrub smoothing on top of Lenis causes double-buffering lag
      var tl = gsap.timeline({
        scrollTrigger: {
          trigger: wrapper,
          start: "top top",
          end: "+=" + window.innerHeight * totalCards,
          pin: true,
          scrub: true,
          pinSpacing: true,
          invalidateOnRefresh: true,
        },
      });

      // Animation sequence:
      // - Next card slides up from below (yPercent 100 → 0)
      // - Current card stays in place (simple sticky stack)
      cards.forEach(function (card, i) {
        if (i === totalCards - 1) return;

        tl.to(
          cards[i + 1],
          {
            yPercent: 0,
            duration: 1,
            ease: "none",
            force3D: true,
          },
          i,
        );
      });

      // Refresh ScrollTrigger on resize to recalculate pin positions
      var resizeTimer;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          ScrollTrigger.refresh();
        }, 200);
      });
    })();
  </script>
</MainLayout>
