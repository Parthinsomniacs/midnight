---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="Services | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-service p-0">
    <div class="container custom-container-1840">
      <div class="scroll-expand" id="scrollExpand">
        <div class="scroll-expand__track" id="seTrack">
          <div class="scroll-expand__stage" id="seStage">
            <div class="scroll-expand__frame black-overlay" id="seFrame">
              <img
                class="scroll-expand__media"
                id="seMedia"
                src={`${imagesurl}services/what-we-do.webp`}
                alt="Services"
                draggable="false"
              />
              <div class="scroll-expand__scrim" id="seScrim"></div>
            </div>
            <div class="scroll-expand__title" id="seTitle">What we do?</div>
          </div>
        </div>
      </div>
    </div>
  </section>

