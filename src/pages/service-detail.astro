---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="Case Study | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-case-study-banner p-0 rr-v-lines-none">
    <div class="custom-container-1840">
      <div class="section-xs theme-xs pb-0">
        <div class="grid-col-3">
          <div class="section-title mb-0">
            <h3 class="fw-500 is-uppercase font-orbitron pl-4 mt-2 line-reveal">
              Our Case Study
            </h3>
          </div>
          <div class="section-title theme-padding-xs">
            <h2 class="text-roll">How we execute?</h2>
          </div>
        </div>
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="case-study-desc rr-v-lines-none gray-bg">
          <div class="theme-padding-xs section-xs">
            <h5 class="line-reveal">
              We’d love to discuss your venture, and potential collaborations
              with Us. Let’s build something great together.
            </h5>
          </div>
        </div>
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="case-study-block gray-bg">
          <div class="grid-col-2">
            <div class="border-left border-right section-xs theme-padding-xs">
              <div class="case-study-title mb-4">
                <h6 class="line-reveal">IFT Enpower Hackathon</h6>
              </div>
              <div class="case-study-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/01.webp`}
                    alt="Case Study"
                    width="915"
                    height="815"
                  />
                </picture>
              </div>
            </div>
            <div class="border-right section-xs theme-padding-xs">
              <div class="case-study-title mb-4">
                <h6 class="line-reveal">Vigo Nets</h6>
              </div>
              <div class="case-study-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/02.webp`}
                    alt="Case Study"
                    width="915"
                    height="815"
                  />
                </picture>
              </div>
            </div>
          </div>
          <div class="theme-h-line theme-outerline-left theme-outerline-right">
          </div>
          <div class="grid-col-2">
            <div class="border-left border-right section-xs theme-padding-xs">
              <div class="case-study-title mb-4">
                <h6 class="line-reveal">IFT Enpower Hackathon</h6>
              </div>
              <div class="case-study-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/03.webp`}
                    alt="Case Study"
                    width="915"
                    height="815"
                  />
                </picture>
              </div>
            </div>
            <div class="border-right section-xs theme-padding-xs">
              <div class="case-study-title mb-4">
                <h6 class="line-reveal">Vigo Nets</h6>
              </div>
              <div class="case-study-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/04.webp`}
                    alt="Case Study"
                    width="915"
                    height="815"
                  />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <h2 class="text-roll">Contact Us</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>Copyright &copy; <b>Midnight</b> {new Date().getFullYear()}</p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Simple image reveal animation on scroll
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var images = document.querySelectorAll(".case-study-img img");
      if (!images.length) return;

      images.forEach(function (img) {
        gsap.set(img, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(img, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: img.closest(".case-study-img"),
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>
</MainLayout>
