---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="runr kids | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}case-study/all-case-study/runr-kids/footer-logo.gif`}
              alt="Midnight Digital"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll">Runr Kids</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/runrkids/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>

          <!-- whatsapp -->
          <a
            href="https://api.whatsapp.com/send?phone=917776888868"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-whatsapp"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path><path
                  d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">whatsapp</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>

          <!-- youtube -->
          <a
            href="https://www.youtube.com/@runrkids"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-youtube"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8"
                ></path><path d="M10 9l5 3l-5 3l0 -6"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">youtube</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                Runr Kids is a modern eCommerce platform designed for parents
                looking for high-quality toys, games, and educational products
                for children. The website offers a seamless shopping experience
                with an extensive product catalog, secure payment options, and
                hassle-free delivery. The platform focuses on providing safe,
                engaging, and development-focused toys for children of all age
                groups
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Frontend</h6>
                  <ul class="list-point">
                    <li>HTML5</li>
                    <li>CSS3</li>
                    <li>JavaScript</li>
                    <li>Bootstrap 5</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Backend</h6>
                  <ul class="list-point">
                    <li>PHP 8</li>
                    <li>Laravel Framework</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Database</h6>
                  <p>MySQL</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/runr-kids/runr-kids-new.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-client section-xs">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="grid-col-2">
        <div class="client-video rr-v-lines-none reveal-media">
          <video autoplay muted loop playsinline width="100%" height="100%">
            <source
              src={`${imagesurl}case-study/all-case-study/runr-kids/client-video.mp4`}
              type="video/mp4"
            />
          </video>
        </div>
        <div
          class="theme-padding-xs section-xs rr-v-lines-none gray-bg border-right"
        >
          <div class="section-title text-rev line-reveal">
            <h2>Services Provided</h2>
            <span class="title-tagline"
              >For this project, we delivered a complete eCommerce solution,
              including:</span
            >
          </div>
          <div class="client-desc">
            <ul class="list-point line-reveal">
              <li>UI/UX Design</li>
              <li>Responsive Website Development</li>
              <li>Custom eCommerce Store Development</li>
              <li>Product Catalog & Category Management</li>
              <li>Shopping Cart & Checkout Integration</li>
              <li>Secure Payment Gateway Integration</li>
              <li>Order & Inventory Management</li>
              <li>User Account & Wishlist Features</li>
              <li>Mobile Optimization</li>
              <li>SEO-Friendly Development</li>
              <li>Performance Optimization</li>
              <li>Website Testing & Deployment</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}case-study/all-case-study/runr-kids/runr-kids-banner.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              Runr Kids is a children's toy and learning products brand focused
              on making quality toys easily accessible through an online
              shopping platform. Their mission is to offer safe, educational,
              and entertaining products while providing parents with a simple
              and convenient buying experience.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <span class="small-titel fw-500 pb-2 d-block line-reveal">The client wanted an eCommerce website that could:</span>
            <ul class="list-point line-reveal">
              <li>Showcase a large collection of toys and learning products.</li>
              <li>Organize products with easy-to-navigate categories.</li>
              <li>Deliver a smooth shopping experience across all devices.</li>
              <li>Enable secure online payments.</li>
              <li>Simplify order management.</li>
              <li>Increase customer trust with a clean and professional design.</li>
              <li>Improve website speed and overall user experience.</li>
              <li>Create a scalable platform for future product expansion.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <p class="line-reveal">
              During the project, the client faced several challenges in managing
              and scaling their online toy store. Our team worked closely with the
              client to understand these pain points and implemented effective
              solutions.
            </p>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>
            <ul class="list-point line-reveal">
              <li>Difficulty managing a large product catalog.</li>
              <li>Products were not organized properly into categories.</li>
              <li>Slow website performance affecting the shopping experience.</li>
              <li>Non-responsive design on mobile devices.</li>
              <li>Complex checkout process leading to cart abandonment.</li>
              <li>Need for secure online payment integration.</li>
              <li>Manual order and inventory management.</li>
              <li>Limited product search and filtering options.</li>
              <li>Poor user experience impacting customer engagement.</li>
              <li>Requirement for a scalable platform to support future growth.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>
            <ul class="list-point line-reveal">
              <li>Faster website performance.</li>
              <li>Improved shopping experience across all devices.</li>
              <li>Easier product and inventory management.</li>
              <li>Secure and seamless online payments.</li>
              <li>Better customer engagement and higher conversion potential.</li>
              <li>A scalable platform capable of supporting business growth.</li>
              <li>SEO-optimized website structure</li>
              <li>Secure and scalable architecture</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Highlighted Features</h3>
            <ul class="list-point line-reveal">
              <li>Child-Friendly Product Catalog</li>
              <li>Smart Search & Filters</li>
              <li>Easy Add-to-Cart, Wishlist, and streamlined Checkout process.</li>
              <li>Secure Payment Gateway</li>
              <li>Fully Responsive Design</li>
              <li>Order Management</li>
              <li>Optimized website speed for faster loading and improved user experience.</li>
              <li>Enhanced security measures to protect customer information and transactions.</li>
              <li>Built with SEO best practices to improve search engine visibility and organic traffic.</li>
              <li>Designed to support future product additions, promotional campaigns, and business growth.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>
</MainLayout>
