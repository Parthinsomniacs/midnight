---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="AClinico | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}case-study/all-case-study/seo-platform/1.svg`}
              alt="Midnight Digital"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll">SEO Platform</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Instagram -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>

          <!-- linkdin -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M8 11v5"></path><path d="M8 8v.01"></path><path
                  d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"
                ></path><path
                  d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
          <!-- facebook -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">facebook</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                GMHA Clinico is a healthcare management platform designed to
                simplify clinic operations by bringing patient management,
                appointment scheduling, medical records, billing, and
                administrative workflows into a single web application. The
                platform helps healthcare providers streamline daily operations,
                reduce manual paperwork, and improve patient care through a
                secure and user-friendly digital solution.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="grid-col-1 pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Frontend</h6>
                  <ul class="list-point">
                    <li>HTML5</li>
                    <li>CSS3</li>
                    <li>JavaScript</li>
                    <li>Bootstrap</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Backend</h6>
                  <p>PHP</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Database</h6>
                  <p>MySQL</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Additional Technologies</h6>
                  <ul class="list-point">
                    <li>REST APIs</li>
                    <li>Google Maps Integration</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/seo-platform.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-client section-xs">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="grid-col-2">
        <div class="client-video rr-v-lines-none reveal-media">
          <video autoplay muted loop playsinline width="100%" height="100%">
            <source
              src={`${imagesurl}case-study/all-case-study/runr-kids/client-video.mp4`}
              type="video/mp4"
            />
          </video>
        </div>
        <div
          class="theme-padding-xs section-xs rr-v-lines-none gray-bg border-right"
        >
          <div class="section-title text-rev line-reveal">
            <h2>Services Provided</h2>
          </div>
          <div class="client-desc">
            <ul class="list-point line-reveal">
              <li>Product Strategy</li>
              <li>UI/UX Design</li>
              <li>SaaS Web Application Development</li>
              <li>Frontend Development</li>
              <li>Backend Development</li>
              <li>Database Architecture</li>
              <li>API Development & Integration</li>
              <li>Dashboard Development</li>
              <li>Performance Optimization</li>
              <li>Authentication & User Management</li>
              <li>QA Testing & Deployment</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}case-study/all-case-study/seo-platform/1.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              GMHA Clinico is built for clinics, healthcare centers, and medical
              practitioners looking to digitize patient management and
              streamline administrative operations. The platform enables
              healthcare professionals to manage appointments, patient records,
              billing, and daily workflows from a centralized system.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <ul class="list-point line-reveal">
              <li>Digitize clinic operations.</li>
              <li>Centralize patient records.</li>
              <li>Simplify appointment scheduling.</li>
              <li>Manage billing and medical history.</li>
              <li>Reduce paperwork and manual processes.</li>
              <li>Provide secure access to healthcare data.</li>
              <li>Build a responsive and easy-to-use platform.</li>
              <li>Improve operational efficiency.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <p class="line-reveal">
              We developed a secure, responsive healthcare management platform
              that allows clinics to efficiently manage patients, appointments,
              consultations, and administrative workflows. The intuitive
              dashboard enables staff and doctors to access real-time
              information, improving patient service while reducing operational
              complexity.
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Client Challenges</h3>
            <p class="line-reveal">
              Before implementing GMHA Clinico, the client faced several
              operational challenges:
            </p>
            <ul class="list-point line-reveal">
              <li>Manual patient registration.</li>
              <li>Paper-based medical records.</li>
              <li>Appointment scheduling conflicts.</li>
              <li>Time-consuming administrative tasks.</li>
              <li>Difficulty tracking patient history.</li>
              <li>Inefficient billing workflows.</li>
              <li>Limited reporting and analytics.</li>
              <li>Lack of centralized clinic management.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>
            <p>
              During development, our team solved several technical challenges:
            </p>
            <ul class="list-point line-reveal">
              <li>Designing a user-friendly healthcare interface.</li>
              <li>Ensuring secure patient data management.</li>
              <li>Optimizing performance for large patient records.</li>
              <li>Developing responsive layouts across devices.</li>
              <li>Creating scalable appointment workflows.</li>
              <li>Streamlining clinic administration.</li>
              <li>Building reliable reporting dashboards.</li>
              <li>Ensuring secure authentication and access control.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>
            <ul class="list-point line-reveal">
              <li>Streamlined clinic operations.</li>
              <li>Faster patient registration and appointment management.</li>
              <li>Reduced administrative workload.</li>
              <li>Improved access to patient medical records.</li>
              <li>Enhanced operational transparency.</li>
              <li>Better staff productivity.</li>
              <li>Responsive experience across desktop and mobile.</li>
              <li>Scalable platform ready for future healthcare modules.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">
              Highlighted Features
            </h3>
            <ul class="list-point line-reveal">
              <li>Patient Management System</li>
              <li>Appointment Scheduling</li>
              <li>Electronic Medical Records (EMR)</li>
              <li>Doctor Dashboard</li>
              <li>Patient History Tracking</li>
              <li>Billing & Invoice Management</li>
              <li>Prescription Management</li>
              <li>Medical Reports Management</li>
              <li>Role-Based User Access</li>
              <li>Real-Time Dashboard</li>
              <li>Notifications & Reminders</li>
              <li>Search & Filter Functionality</li>
              <li>Responsive Design</li>
              <li>Secure Authentication</li>
              <li>Performance-Optimized Web Application</li>
              <li>Cloud-Based Management System</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <h2 class="text-roll">Contact Us</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>Copyright &copy; <b>Midnight</b> {new Date().getFullYear()}</p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <script is:inline>
    // Disable sticky on mobile - ScrollTrigger handles responsive
    (function () {
      if (typeof ScrollTrigger === "undefined") return;
      // Refresh ScrollTrigger after layout settles
      ScrollTrigger.refresh();
    })();
  </script>
</MainLayout>
