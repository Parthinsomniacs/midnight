---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="Circle Ledger | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}case-study/all-case-study/circle-ledger/logo.svg`}
              alt="Midnight Digital"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll">Circle Ledger</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Instagram -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>

          <!-- linkdin -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M8 11v5"></path><path d="M8 8v.01"></path><path
                  d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"
                ></path><path
                  d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
          <!-- facebook -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">facebook</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                Circle Ledger is a cloud-based financial and member management
                platform built specifically for kitty groups, savings clubs,
                community organizations, and multi-chapter networks. The
                platform digitizes financial operations by automating member
                management, meeting scheduling, payment tracking, analytics, and
                notifications—all from a single centralized dashboard. It is
                designed to replace manual bookkeeping with a secure,
                transparent, and scalable digital solution.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Frontend</h6>
                  <p>Next.js</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Backend</h6>
                  <p>Node.js</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Database</h6>
                  <p>MongoDB</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/circle-ledger/circle-ledger-img.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-client section-xs">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="grid-col-2">
        <div class="client-video rr-v-lines-none reveal-media">
          <video autoplay muted loop playsinline width="100%" height="100%">
            <source
              src={`${imagesurl}case-study/all-case-study/runr-kids/client-video.mp4`}
              type="video/mp4"
            />
          </video>
        </div>
        <div
          class="theme-padding-xs section-xs rr-v-lines-none gray-bg border-right"
        >
          <div class="section-title text-rev line-reveal">
            <h2>Services Provided</h2>
          </div>
          <div class="client-desc">
            <ul class="list-point line-reveal">
              <li>Product Strategy</li>
              <li>UI/UX Design</li>
              <li>Web Application Development</li>
              <li>Frontend Development</li>
              <li>Backend Development</li>
              <li>Dashboard Development</li>
              <li>Role-Based Access Control (RBAC)</li>
              <li>Analytics Dashboard</li>
              <li>Notification System</li>
              <li>Performance Optimization</li>
              <li>QA Testing & Deployment</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}case-study/all-case-study/circle-ledger/circle-ledger.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              Circle Ledger is a SaaS platform created to simplify the
              management of financial communities, kitty groups, and
              member-based organizations. It enables administrators to manage
              multiple chapters, monitor finances, schedule meetings, and
              generate reports while giving members a seamless digital
              experience.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <ul class="list-point line-reveal">
              <li>Replace manual bookkeeping and spreadsheets.</li>
              <li>Centralize member and chapter management.</li>
              <li>Automate meeting scheduling and attendance.</li>
              <li>Track member contributions and payments.</li>
              <li>Provide role-based access for different users.</li>
              <li>Generate real-time financial insights.</li>
              <li>Improve transparency and accountability.</li>
              <li>Enable secure access from any device.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <p class="line-reveal">
              We designed and developed a modern SaaS platform that digitizes
              every aspect of community financial management. The solution
              provides administrators with complete control over members,
              meetings, collections, payments, and analytics through an
              intuitive dashboard. Automated reminders, role-based permissions,
              and real-time reporting significantly reduce manual effort while
              improving operational efficiency.
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Client Challenges</h3>
            <p class="line-reveal">
              Before implementing Circle Ledger, the client encountered several
              operational issues:
            </p>
            <ul class="list-point line-reveal">
              <li>Manual bookkeeping and paper-based records.</li>
              <li>Difficulty managing multiple city chapters.</li>
              <li>Lack of transparency in financial transactions.</li>
              <li>Manual meeting scheduling and attendance tracking.</li>
              <li>Delayed payment collection.</li>
              <li>No centralized reporting system.</li>
              <li>Limited visibility into organization performance.</li>
              <li>High administrative workload.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>
            <p>
              During development, our team addressed several technical and
              business challenges:
            </p>
            <ul class="list-point line-reveal">
              <li>Designing a secure multi-user SaaS architecture.</li>
              <li>Implementing granular Role-Based Access Control (RBAC).</li>
              <li>Building real-time financial dashboards.</li>
              <li>Managing multi-city chapter data efficiently.</li>
              <li>Automating payment and meeting workflows.</li>
              <li>Ensuring scalability for growing organizations.</li>
              <li>Delivering a responsive experience across all devices.</li>
              <li>Maintaining high performance with large datasets.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>
            <ul class="list-point line-reveal">
              <li>99% reduction in manual bookkeeping efforts.</li>
              <li>Faster member onboarding and management.</li>
              <li>Improved transparency in financial records.</li>
              <li>Centralized dashboard for all chapters.</li>
              <li>Automated meeting reminders and notifications.</li>
              <li>Better payment tracking and collection management.</li>
              <li>Real-time business insights through analytics.</li>
              <li>Increased operational efficiency and member engagement.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">
              Highlighted Features
            </h3>
            <ul class="list-point line-reveal">
              <li>Multi-City Chapter Management</li>
              <li>Member Management System</li>
              <li>Role-Based Access Control (RBAC)</li>
              <li>Secure Authentication & Permissions</li>
              <li>Meeting Scheduling & Attendance Tracking</li>
              <li>Automated Payment & Due Collection</li>
              <li>Financial Workflow Automation</li>
              <li>Real-Time Analytics Dashboard</li>
              <li>Smart Notifications & Alerts</li>
              <li>Dashboard Reporting</li>
              <li>Multi-User Admin Panel</li>
              <li>Activity Tracking</li>
              <li>Mobile Responsive Design</li>
              <li>Cloud-Based SaaS Platform</li>
              <li>Data Security & Access Management</li>
              <li>Performance-Optimized Architecture</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <h2 class="text-roll">Contact Us</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>Copyright &copy; <b>Midnight</b> {new Date().getFullYear()}</p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <script is:inline>
    // Disable sticky on mobile - ScrollTrigger handles responsive
    (function () {
      if (typeof ScrollTrigger === "undefined") return;
      // Refresh ScrollTrigger after layout settles
      ScrollTrigger.refresh();
    })();
  </script>
</MainLayout>
