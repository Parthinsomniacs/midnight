---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="The Fund Forge | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}case-study/all-case-study/the-fund-forge/logo.svg`}
              alt="Midnight Digital"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll">The Fund Forge</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/thefundforge/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>

          <!-- linkdin -->
          <a
            href="https://www.instagram.com/thefundforge/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M8 11v5"></path><path d="M8 8v.01"></path><path
                  d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"
                ></path><path
                  d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
          <!-- facebook -->
          <a
            href="facebook.com/share/1EWEsc9Ken/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">facebook</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                The Fund Forge is a modern financial consulting and investment
                platform focused on helping individuals and businesses achieve
                their financial goals through strategic investment planning,
                wealth management, and expert financial guidance. The objective
                was to create a professional, trustworthy, and user-friendly
                website that effectively communicates the company's services
                while generating quality leads.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Technology Stack</h6>
                  <ul
                    class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                  >
                    <li>Figma (UI/UX Design)</li>
                    <li>HTML5</li>
                    <li>CSS3</li>
                    <li>JavaScript</li>
                    <li>PHP</li>
                    <li>MySQL</li>
                    <li>Bootstrap</li>
                    <li>Google Maps Integration</li>
                    <li>Google Analytics</li>
                    <li>SEO Optimization</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/the-fund-forge/the-fund-forge-banner.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-client section-xs">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="grid-col-2">
        <div class="client-video rr-v-lines-none reveal-media">
          <video autoplay muted loop playsinline width="100%" height="100%">
            <source
              src={`${imagesurl}case-study/all-case-study/runr-kids/client-video.mp4`}
              type="video/mp4"
            />
          </video>
        </div>
        <div
          class="theme-padding-xs section-xs rr-v-lines-none gray-bg border-right"
        >
          <div class="section-title text-rev line-reveal">
            <h2>Services Provided</h2>
            <span class="title-tagline"
              >For this project, we delivered a complete eCommerce solution,
              including:</span
            >
          </div>
          <div class="client-desc">
            <ul class="list-point line-reveal">
              <li>UI/UX Design</li>
              <li>Custom Website Design</li>
              <li>Frontend Development</li>
              <li>Backend Development</li>
              <li>Responsive Web Development</li>
              <li>Contact & Lead Generation Forms</li>
              <li>Performance Optimization</li>
              <li>SEO-Friendly Development</li>
              <li>Website Deployment & Testing</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}case-study/all-case-study/the-fund-forge/the-fund-forge.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              The Fund Forge provides financial planning, investment consulting,
              wealth management, and business funding advisory services. Their
              goal is to simplify complex financial decisions and help clients
              build long-term financial success through personalized strategies.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <ul class="list-point line-reveal">
              <li>Build a professional financial services website.</li>
              <li>Establish trust and credibility through modern design.</li>
              <li>Clearly showcase investment and financial services.</li>
              <li>Generate qualified customer enquiries.</li>
              <li>Ensure mobile responsiveness.</li>
              <li>Improve website speed and SEO.</li>
              <li>Create an easy-to-manage content structure.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <p class="line-reveal">
              We designed and developed a clean, modern, and conversion-focused
              website that reflects The Fund Forge's expertise in financial
              consulting. The website features intuitive navigation,
              strategically placed call-to-actions, informative service pages,
              and responsive layouts, making it easy for visitors to explore
              services and connect with financial experts.
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Client Challenges</h3>
            <p class="line-reveal">
              Before working with us, the client faced several business
              challenges:
            </p>
            <ul class="list-point line-reveal">
              <li>Limited online presence.</li>
              <li>Outdated website design affecting credibility.</li>
              <li>Poor lead generation.</li>
              <li>Difficult navigation.</li>
              <li>Website not optimized for mobile users.</li>
              <li>Lack of clear presentation of financial services.</li>
              <li>Low search engine visibility.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>
            <p>
              During development, our team addressed several technical and
              design challenges:
            </p>
            <ul class="list-point line-reveal">
              <li>
                Creating a premium and trustworthy financial brand identity.
              </li>
              <li>
                Organizing complex financial services into an easy-to-understand
                structure.
              </li>
              <li>
                Optimizing performance while maintaining rich visual content.
              </li>
              <li>Ensuring consistent user experience across all devices.</li>
              <li>
                Implementing responsive layouts for multiple screen sizes.
              </li>
              <li>Improving page loading speed and SEO performance.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>
            <ul class="list-point line-reveal">
              <li>Professional and modern online presence.</li>
              <li>Improved customer trust and brand credibility.</li>
              <li>Better lead generation through optimized enquiry forms.</li>
              <li>Faster website performance.</li>
              <li>Fully responsive across desktop, tablet, and mobile.</li>
              <li>Improved user engagement.</li>
              <li>SEO-ready website architecture.</li>
              <li>Easy content management for future updates.</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">
              Highlighted Features
            </h3>
            <ul class="list-point line-reveal">
              <li>AI Innovation Articles</li>
              <li>Startup Stories & Insights</li>
              <li>Funding News & Investment Updates</li>
              <li>Founder Success Stories</li>
              <li>Unicorn Startup Stories</li>
              <li>Business Strategy & Growth Content</li>
              <li>Category-wise Content Organization</li>
              <li>Search & Filter Functionality</li>
              <li>Featured Articles Section</li>
              <li>Latest News & Trending Topics</li>
              <li>Responsive News & Blog Layout</li>
              <li>SEO-Optimized Content Pages</li>
              <li>Newsletter Subscription</li>
              <li>Social Media Sharing</li>
              <li>Admin-Managed Content Management System (CMS)</li>
              <li>Mobile-Friendly Reading Experience</li>
              <li>Fast Page Loading Performance</li>
              <li>User-Friendly Navigation</li>
              <li>Secure & Scalable Platform</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <h2 class="text-roll">Contact Us</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>Copyright &copy; <b>Midnight</b> {new Date().getFullYear()}</p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <script is:inline>
    // Disable sticky on mobile - ScrollTrigger handles responsive
    (function () {
      if (typeof ScrollTrigger === "undefined") return;
      // Refresh ScrollTrigger after layout settles
      ScrollTrigger.refresh();
    })();
  </script>
</MainLayout>
