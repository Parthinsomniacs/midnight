---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import FootScripts from "../../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
    title="SSX | Midnight Digital Pvt Ltd"
    swiper={true}
    page="home"
    pagetype="onepage"
>
    <Header page="home" />

    <section class="section-casestudy-detail section-xs pb-2">
        <div class="custom-container-1840">
            <div class="grid-col-4 is-align-items-center">
                <div class="casstudy-detail-logo">
                    <picture>
                        <img
                            class="mb-0"
                            src={`${imagesurl}product/new-product/ssx/logo1.webp`}
                            alt="ssx"
                            width="145"
                            height="70"
                        />
                    </picture>
                </div>
                <div
                    class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
                >
                    <h2 class="text-roll">SSX</h2>
                </div>
                <div class="case-study-page-detail-social-icon">
                    <!-- Instagram -->
                    <a
                        href="https://www.instagram.com/ssx_india/"
                        target="_blank"
                        class="social-block"
                    >
                        <div class="social-icon-box">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                                ><path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"></path><path
                                    d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                                ></path><path
                                    d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                                ></path><path d="M16.5 7.5v.01"></path></svg
                            >
                        </div>
                        <div class="social-info">
                            <h5 class="social-name">Instagram</h5>
                            <span class="social-username">@runrkids</span>
                        </div>
                    </a>
                    <!-- linkdin -->
                    <a
                        href="https://www.linkedin.com/company/society-for-study-of-xenobiotics-india/"
                        target="_blank"
                        class="social-block"
                    >
                        <div class="social-icon-box">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
                                ><path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"></path><path d="M8 11v5"
                                ></path><path d="M8 8v.01"></path><path
                                    d="M12 16v-5"></path><path
                                    d="M16 16v-3a2 2 0 1 0 -4 0"></path><path
                                    d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"
                                ></path></svg
                            >
                        </div>
                        <div class="social-info">
                            <h5 class="social-name">Instagram</h5>
                            <span class="social-username">@runrkids</span>
                        </div>
                    </a>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="grid-col-2">
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
                >
                    <div
                        class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
                    >
                        <div class="theme-padding-xs section-xs">
                            <h3 class="mb-5 fw-500 line-reveal">
                                Project Overview
                            </h3>
                            <p class="has-text-justified line-reveal">
                                SSX India is a non-profit scientific society
                                focused on advancing knowledge and awareness of
                                DMPK/ADMET within India's drug discovery and
                                development community.The platform brings
                                together researchers, academicians, students and
                                pharmaceutical professionals through
                                conferences, workshops, mentorship and
                                scientific education.
                            </p>
                        </div>
                        <div class="is-relative">
                            <div class="theme-h-line"></div>
                            <div class="pb-0">
                                <div
                                    class="product-detail-block section-xs theme-padding-xs line-reveal"
                                >
                                    <h6>Technology Stack</h6>
                                    <ul
                                        class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                                    >
                                        <li>Figma (UI/UX Design)</li>
                                        <li>HTML5</li>
                                        <li>CSS3</li>
                                        <li>JavaScript</li>
                                        <li>PHP</li>
                                        <li>MySQL</li>
                                        <li>Maps</li>
                                        <li>PDF Integration</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-right"
                >
                    <div class="case-study-image reveal-media">
                        <picture>
                            <img
                                src={`${imagesurl}product/new-product/ssx/15.webp`}
                                alt="Case Study"
                                width="915"
                                height="815"
                            />
                        </picture>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-image pb-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="image-container">
                <picture>
                    <img
                        src={`${imagesurl}product/new-product/ssx/banner1.webp`}
                        alt="Banner"
                        width="1920"
                        height="1080"
                    />
                </picture>
            </div>
        </div>
    </section>

    <section class="section-case-detail section-xs pb-0">
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="custom-container-1840">
            <div class="case-detail-layout">
                <!-- Left Side - Sticky -->
                <div class="case-detail-left section-xs theme-padding-xs">
                    <div class="section-title">
                        <h2 class="line-reveal">The Client</h2>
                    </div>
                    <div class="client-desc line-reveal">
                        <p>
                            The website serves as a central platform for annual
                            conferences, DMPK certification courses, abstract
                            submissions, registrations, scientific events, news
                            and community engagement.SSX India is a non-profit
                            scientific society focused on advancing knowledge
                            and awareness of DMPK/ADMET within India's drug
                            discovery and development community.The platform
                            brings together researchers, academicians, students
                            and pharmaceutical professionals through
                            conferences, workshops, mentorship and scientific
                            education.
                        </p>
                    </div>
                </div>

                <!-- Right Side - Scrollable -->
                <div class="case-detail-right">
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Core Requirements
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Establish a professional digital platform for
                                SSX India.
                            </li>
                            <li>
                                Promote DMPK and ADMET knowledge within the
                                scientific community.
                            </li>
                            <li>
                                Provide a centralized platform for annual
                                conferences and events.
                            </li>
                            <li>
                                Enable scientific course and professional
                                learning opportunities.
                            </li>
                            <li>
                                Support abstract submission and conference
                                participation.
                            </li>
                            <li>
                                Connect researchers, academicians, students and
                                industry professionals.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>

                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            The Solution
                        </h3>
                        <p class="line-reveal">
                            Developed a centralized scientific community
                            platform for SSX India Created dedicated sections
                            for conferences, courses and scientific events Added
                            structured DMPK course information and registration
                            pathways Implemented an online abstract submission
                            workflow Created detailed event schedules and
                            speaker information Added council member and expert
                            profiles Integrated gallery, news feed and
                            sponsorship sections Added contact and newsletter
                            subscription functionality.
                        </p>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Client Challenges
                        </h3>
                        <p class="line-reveal">
                            Presenting complex scientific information in an accessible structure:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                                Managing multiple conferences, courses and academic activities.
                            </li>
                            <li>
                                Connecting different audiences including students, researchers and industry professionals.
                            </li>
                            <li>
                                Maintaining credibility through scientific experts and institutional affiliations.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Challenges
                        </h3>
                        <p>
                            Structuring large amounts of conference and scientific content:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                                Creating separate user journeys for courses, events and submissions.
                            </li>
                            <li>
                                Managing detailed speaker and council member information.
                            </li>
                            <li>
                                Presenting extensive conference schedules clearly.
                            </li>
                            <li>
                                Maintaining a professional scientific identity across the platform.
                            </li>
                            <li>
                                Supporting document/PDF downloads and submissions.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">Results</h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Created a centralized digital hub for SSX India activities.
                            </li>
                            <li>
                               Simplified access to conferences, courses and scientific resources.
                            </li>
                            <li>
                                Streamlined abstract submission and event participation.
                            </li>
                            <li>
                                Improved visibility of scientific experts and council members.
                            </li>
                             <li>
                                Consolidated events, education, news and community information into one platform.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Highlighted Features
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>DMPK Certificate Course</li>
                            <li>Annual International Conference</li>
                            <li>Conference Registration</li>
                            <li>Abstract Submission</li>
                            <li>PDF Abstract Upload</li>
                            <li>Conference Program & Schedule</li>
                            <li>Keynote & Speaker Showcase</li>
                            <li>Scientific Council Members</li>
                            <li>Mentorship Sessions</li>
                            <li>Poster & Oral Presentation Prizes</li>
                            <li>One-Day Symposia</li>
                            <li>Sponsorship Information</li>
                            <li>Scientific Workshops</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-footer section-xs pt-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="contact-us-title section-xs pb-0">
                <div class="section-title mb-0">
                    <h3 class="fw-500 is-uppercase font-orbitron pl-4">
                        Let's Talk
                    </h3>
                    <div class="theme-h-line"></div>
                </div>
                <div class="section-title pl-4">
                    <h2 class="text-roll">Contact Us</h2>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="footer-box">
                <div class="media-wrapper">
                    <div class="footer-logo pl-4">
                        <picture>
                            <img
                                src={`${imagesurl}logo.svg`}
                                alt="Midnight Digital Logo"
                                width="145"
                                height="70"
                            />
                        </picture>
                    </div>
                    <div class="social-links">
                        <ul>
                            {
                                [
                                    "Facebook",
                                    "Instagram",
                                    "LinkedIn",
                                    "Twitter",
                                ].map((social) => (
                                    <li>
                                        <a href="#">
                                            {social}
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <>
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                                                </>
                                            </svg>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="copyright-text pl-4">
                        <p>
                            Copyright &copy; <b>Midnight</b>
                            {new Date().getFullYear()}
                        </p>
                    </div>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
        </div>
    </section>

    <FootScripts page="home" pagetype="onepage" />

    <script is:inline>
        // Reveal animation on scroll for .reveal-media elements
        document.addEventListener("DOMContentLoaded", function () {
            if (
                typeof gsap === "undefined" ||
                typeof ScrollTrigger === "undefined"
            )
                return;

            var elements = document.querySelectorAll(".reveal-media");
            if (!elements.length) return;

            elements.forEach(function (el) {
                gsap.set(el, {
                    clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                });

                gsap.to(el, {
                    clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                    duration: 1.2,
                    ease: "power3.inOut",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 80%",
                        once: true,
                    },
                });
            });
        });
    </script>

    <script is:inline>
        // Disable sticky on mobile - ScrollTrigger handles responsive
        (function () {
            if (typeof ScrollTrigger === "undefined") return;
            // Refresh ScrollTrigger after layout settles
            ScrollTrigger.refresh();
        })();
    </script>
</MainLayout>
