---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FootScripts from "../../components/FootScripts.astro";
import EnquiryPopup from "../../components/EnquiryPopup.astro";

const imagesurl = "/media/images/";
---

<MainLayout
    title="Alap | Midnight Digital Pvt Ltd"
    swiper={true}
    page="home"
    pagetype="onepage"
>
    <Header page="home" />

    <section class="section-casestudy-detail section-xs pb-2">
        <div class="custom-container-1840">
            <div class="grid-col-4 is-align-items-center">
                <div class="casstudy-detail-logo">
                    <picture>
                        <img
                            class="mb-0"
                            src={`${imagesurl}product/new-product/alap/logo1.webp`}
                            alt="Alap"
                            width="145"
                            height="70"
                        />
                    </picture>
                </div>
                <div
                    class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
                >
                    <h2 class="text-roll text-roll-single-line">Alaap Mobile APP</h2>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="grid-col-2">
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
                >
                    <div
                        class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
                    >
                        <div class="theme-padding-xs section-xs">
                            <h3 class="mb-5 fw-500 line-reveal">
                                Project Overview
                            </h3>
                            <p class="has-text-justified line-reveal">
                                We developed a dedicated mobile application for
                                Lok-Dakshinamoorthy Educational Institutes to
                                create a connected digital community for
                                students, faculty, and alumni. The app brings
                                institutional communication, social interaction,
                                discussions, events, and student engagement
                                together on a single platform. It provides users
                                with an easy and engaging way to stay informed,
                                connect with the institute community, and
                                participate in campus activities.
                            </p>
                        </div>
                        <div class="is-relative">
                            <div class="theme-h-line"></div>
                            <div class="pb-0">
                                <div
                                    class="product-detail-block section-xs theme-padding-xs line-reveal"
                                >
                                    <h6>Technology Stack</h6>
                                    <ul
                                        class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                                    >
                                        <li>Figma (UI/UX Design)</li>
                                        <li>node</li>
                                        <li>flutter</li>
                                        <li>Android</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="theme-h-line"></div>
                        </div>
                    </div>
                </div>
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-right"
                >
                    <div class="case-study-image reveal-media">
                        <picture>
                            <img
                                src={`${imagesurl}product/new-product/alap/11.webp`}
                                alt="Case Study"
                                width="915"
                                height="815"
                            />
                        </picture>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-image pb-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="image-container">
                <picture>
                    <img
                        src={`${imagesurl}product/new-product/alap/banner.webp`}
                        alt="Banner"
                        width="1920"
                        height="1080"
                    />
                </picture>
            </div>
        </div>
    </section>

    <section class="section-case-detail section-xs pb-0">
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="custom-container-1840">
            <div class="case-detail-layout">
                <!-- Left Side - Sticky -->
                <div class="case-detail-left section-xs theme-padding-xs">
                    <div class="section-title">
                        <h2 class="line-reveal">The Client</h2>
                    </div>
                    <div class="client-desc line-reveal">
                        <p>
                            The institute needed a centralized digital platform
                            to improve communication and engagement among
                            students, faculty, and alumni.
                        </p>
                    </div>
                </div>

                <!-- Right Side - Scrollable -->
                <div class="case-detail-right">
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Core Requirements
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>
                                The institute needed a centralized digital
                                platform to improve communication and engagement
                                among students, faculty, and alumni.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>

                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            The Solution
                        </h3>
                        <p class="line-reveal">
                            We developed **Alaap**, a dedicated community and
                            communication mobile app designed specifically for
                            Lok-Dakshinamoorthy Educational Institutes. The
                            application combines institutional communication
                            with social and community features, creating a
                            single digital space where members can connect,
                            communicate, share, and collaborate.
                        </p>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Client Challenges
                        </h3>
                        <p class="line-reveal">
                            Sharing institutional announcements and updates
                            efficiently:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                                Creating better communication between students
                                and faculty.
                            </li>
                            <li>
                                Providing a platform for discussions and
                                community interaction.
                            </li>
                            <li>
                                Keeping students updated about events and
                                activities.
                            </li>
                            <li>
                                Giving students a space to showcase their
                                achievements and talents.
                            </li>
                            <li>
                                Managing media and community content in one
                                place.
                            </li>
                            <li>
                                Building stronger engagement across the
                                institute community.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Challenges
                        </h3>
                        <p>
                            The institute needed a centralized digital platform
                            to improve communication and engagement among
                            students, faculty, and alumni. :
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                                Providing a platform for discussions and
                                community interaction.
                            </li>
                            <li>
                                Keeping students updated about events and
                                activities.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">Results</h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Alaap brings the institute community together
                                through a single, easy-to-use mobile platform.
                                It helps improve communication, increase student
                                participation, encourage collaboration, and
                                create a stronger connection between students,
                                faculty, and alumni. .
                            </li>
                            <li>
                                The app transforms traditional institutional
                                communication into a more **connected,
                                interactive, and engaging digital experience.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Highlighted Features
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Institutional News & Announcements - Users can
                                stay updated with official institute news,
                                circulars, important updates, and upcoming
                                events.
                            </li>
                            <li>
                                Social Feed - Users can stay updated with
                                official institute news, circulars, important
                                updates, and upcoming events.
                            </li>
                            <li>
                                Discussion Forums- Dedicated discussion spaces
                                allow users to participate in academic
                                conversations, exchange ideas, and engage with
                                other members.
                            </li>
                            <li>
                                Personalised Notifications - Users receive
                                relevant notifications for announcements,
                                events, deadlines, and other important
                                activities.
                            </li>
                            <li>
                                Faculty Interaction - The platform creates a
                                dedicated space for students and faculty to
                                communicate and engage constructively.
                            </li>
                            <li>
                                Student Contributions - Students can showcase
                                their achievements, talents, creative work, and
                                other contributions to the institute community.
                            </li>
                            <li>
                                Media Sharing - Users can share and explore
                                images, videos, and documents related to
                                institute activities and events.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

  <Footer />

    <FootScripts page="home" pagetype="onepage" />

    <script is:inline>
        // Reveal animation on scroll for .reveal-media elements
        document.addEventListener("DOMContentLoaded", function () {
            if (
                typeof gsap === "undefined" ||
                typeof ScrollTrigger === "undefined"
            )
                return;

            var elements = document.querySelectorAll(".reveal-media");
            if (!elements.length) return;

            elements.forEach(function (el) {
                gsap.set(el, {
                    clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                });

                gsap.to(el, {
                    clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                    duration: 1.2,
                    ease: "power3.inOut",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 80%",
                        once: true,
                    },
                });
            });
        });
    </script>

    <script is:inline>
        // Disable sticky on mobile - ScrollTrigger handles responsive
        (function () {
            if (typeof ScrollTrigger === "undefined") return;
            // Refresh ScrollTrigger after layout settles
            ScrollTrigger.refresh();
        })();
    </script>

    <EnquiryPopup />
</MainLayout>
