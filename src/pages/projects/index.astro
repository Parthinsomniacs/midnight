<script is:inline>
  // Varied image reveal animations on scroll
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
      return;

    var images = document.querySelectorAll(".case-study-img img");
    if (!images.length) return;

    // Different reveal directions
    var reveals = [
      // Left to right
      { from: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)", to: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" },
      // Right to left
      { from: "polygon(100% 0%, 100% 0%, 100% 100%, 100% 100%)", to: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" },
      // Top to bottom
      { from: "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)", to: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" },
      // Bottom to top
      { from: "polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)", to: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" },
      // Center expand
      { from: "polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%)", to: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)" },
    ];

    images.forEach(function (img, index) {
      var reveal = reveals[index % reveals.length];

      gsap.set(img, {
        clipPath: reveal.from,
      });

      gsap.to(img, {
        clipPath: reveal.to,
        duration: 1.2,
        ease: "power3.inOut",
        scrollTrigger: {
          trigger: img.closest(".case-study-img"),
          start: "top 80%",
          once: true,
        },
      });
    });
  });
</script>
