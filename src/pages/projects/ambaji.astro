---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import FootScripts from "../../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="Jay Ambaji App | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}product/new-product/ambaji/logo1.webp`}
              alt="Jay Ambaji App"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll text-roll-single-line">Jay Ambaji Mobile App</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                Ambaji Touch is a dedicated mobile application developed for
                JAY AMBAJI SILVER TOUCH LAB, designed to digitally
                streamline the silver testing, touch assessment, and report
                management process.The application provides customers with a
                centralized digital platform to access their testing
                information, view touch-related records and reports, manage
                their profile, and communicate with the laboratory. By moving
                key information from traditional paper-based processes to a
                digital environment, the application improves accessibility,
                convenience, and customer engagement. The solution is designed
                to provide a simple and user-friendly mobile experience while
                enabling the laboratory to deliver testing-related information
                to customers in a faster and more organized manner.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Technology Stack</h6>
                  <ul
                    class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                  >
                    <li>Android</li>
                    <li>Mobile</li>
                  </ul>
                </div>
              </div>
              <div class="theme-h-line"></div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}product/new-product/ambaji/6.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}product/new-product/ambaji/banner.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              The primary objective of the Ambaji Touch application is to
              **digitize and simplify the silver testing report access and
              customer communication process**. The application aims to reduce
              dependency on physical documentation and provide customers with
              convenient, anytime access to their testing records and related
              information.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <ul class="list-point line-reveal">
              <li>Digitizing silver touch and testing records.</li>
              <li>Digitizing silver touch and testing records.</li>
              <li>
                Reducing dependency on physical paperwork and manual record
                handling.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <p class="line-reveal">
              Improving customer convenience and accessibility. Minimizing
              reliance on physical reports. Making historical testing
              information easier to retrieve. Streamlining customer
              communication. Supporting a more organized digital
              record-management process. Strengthening the laboratory's digital
              presence and customer experience.
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>
            <p>
              A centralized dashboard that provides users with quick access to
              the application's major functions and relevant testing
              information:
            </p>
            <ul class="list-point line-reveal">
              <li>
                Users can maintain and access their personal and contact
                information through a dedicated profile section.
              </li>
              <li>
                The application enables customers to access their silver
                touch/testing records digitally, making historical information
                easier to retrieve and manage.
              </li>
              <li>
                Customers can view relevant testing details and reports directly
                through the mobile application, reducing the need for physical
                documentation.
              </li>
              <li>
                An integrated chat functionality facilitates direct
                communication between customers and the laboratory for queries
                and testing-related discussions.
              </li>
              <li>
                The application provides customers with convenient access to
                their information through a mobile-first interface, allowing
                them to check relevant records whenever required.
              </li>
              <li>
                Customer profiles, testing information, and related records are
                organized within a single digital platform for easier
                accessibility and management.
              </li>
              <li>
                The Ambaji Touch application helps transform a traditional
                silver testing workflow into a more **digital, accessible, and
                customer-centric experience**.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>
            <ul class="list-point line-reveal">
              <li>
                The Ambaji Touch application provides **JAY AMBAJI SILVER TOUCH
                LAB** with a dedicated digital platform for delivering
                testing-related information and services to its customers. The
                application combines digital report accessibility, customer
                profile management, communication, and testing records into a
                single mobile experience, helping create a more efficient and
                convenient service ecosystem.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">
              Highlighted Features
            </h3>
            <ul class="list-point line-reveal">
              <li>Dashboard</li>
              <li>User Profile Management</li>
              <li>Digital Touch Records</li>
              <li>Test Report Management</li>
              <li>In-App Communication</li>
              <li>Mobile Accessibility</li>
              <li>Centralized Information Access</li>
              <li>Business Value</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <a href="/contact"><h2 class="text-roll">Contact Us</h2></a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>
              Copyright &copy; <b>Midnight</b>
              {new Date().getFullYear()}
            </p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <script is:inline>
    // Disable sticky on mobile - ScrollTrigger handles responsive
    (function () {
      if (typeof ScrollTrigger === "undefined") return;
      // Refresh ScrollTrigger after layout settles
      ScrollTrigger.refresh();
    })();
  </script>
</MainLayout>
