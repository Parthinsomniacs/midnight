    <section class="section-image pb-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="image-container">
                <picture>
                    <img
                        src={`${imagesurl}product/new-product/antarang/banner1.webp`}
                        alt="Banner"
                        width="1920"
                        height="1080"
                    />
                </picture>
            </div>
        </div>
    </section>

    <section class="section-case-detail section-xs pb-0">
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="custom-container-1840">
            <div class="case-detail-layout">
                <!-- Left Side - Sticky -->
                <div class="case-detail-left section-xs theme-padding-xs">
                    <div class="section-title">
                        <h2 class="line-reveal">The Client</h2>
                    </div>
                    <div class="client-desc line-reveal">
                        <p>
                            Antarang Crafts is an e-commerce platform showcasing
                            and selling authentic handcrafted Indian products
                            made by rural artisans.It includes online shopping,
                            product filtering, wishlist/cart, bulk enquiry,
                            catalogue download, workshops/events, gallery and
                            contact functionality.
                        </p>
                    </div>
                </div>

                <!-- Right Side - Scrollable -->
                <div class="case-detail-right">
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Core Requirements
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Build a strong digital presence for
                                artisan-crafted products
                            </li>
                            <li>
                                Easy product discovery with category and
                                filter-based browsing.
                            </li>
                            <li>
                                Online shopping experience with cart and
                                wishlist.
                            </li>
                            <li>
                                Organize products into clear categories and
                                collections.
                            </li>
                            <li>
                                Enable easy product discovery through filters.
                            </li>
                            <li>Support retail and bulk purchase enquiries.</li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>

                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            The Solution
                        </h3>
                        <p class="line-reveal">
                            Developed a custom e-commerce platform for
                            handcrafted products Created structured product
                            categories and collections Integrated wishlist, cart
                            and checkout functionality Added dedicated bulk
                            enquiry and catalogue features Built dedicated
                            sections for events, workshops and gallery.
                        </p>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Client Challenges
                        </h3>
                        <p class="line-reveal">
                            Bringing traditional crafts to a modern digital audience:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>Making a diverse product catalogue easy to explore.</li>
                            <li>
                                Simplifying the online purchasing journey.
                            </li>
                            <li>Communicating artisan stories and brand values effectively.</li>
                            <li>Managing both retail and bulk customer enquiries.</li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Challenges
                        </h3>
                        <p>
                            Structuring diverse handcrafted product categories:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                                Maintaining a seamless browsing and filtering experience.
                            </li>
                            <li>
                               Balancing e-commerce functionality with brand storytelling.
                            </li>
                            <li>
                                Creating a responsive experience across devices.
                            </li>
                            <li>
                               Integrating multiple customer engagement touchpoints.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">Results</h3>
                        <ul class="list-point line-reveal">
                            <li>Established a complete online storefront for Antarang Crafts.</li>
                            <li>
                               Improved product discovery and browsing experience.
                            </li>
                            <li>
                                Streamlined the online shopping journey.
                            </li>
                            <li>Created dedicated enquiry and catalogue workflows.</li>
                            <li>
                                Strengthened the brand’s digital presence.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Highlighted Features
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>Product Categories & Advanced Filtering</li>
                            <li>Wishlist & Shopping Cart</li>
                            <li>Online Checkout</li>
                            <li>Events & Workshops Section</li>
                            <li>Bulk Order Enquiry</li>
                            <li>Catalogue Download</li>
                            <li>Gallery Showcase</li>
                            <li>Search & Filter Functionality</li>
                            <li>SEO-Optimized Content Pages</li>
                            <li>Social Media Sharing</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-footer section-xs pt-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="contact-us-title section-xs pb-0">
                <div class="section-title mb-0">
                    <h3 class="fw-500 is-uppercase font-orbitron pl-4">
                        Let's Talk
                    </h3>
                    <div class="theme-h-line"></div>
                </div>
                <div class="section-title pl-4">
                    <a href="/contact"><h2 class="text-roll">Contact Us</h2></a>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="footer-box">
                <div class="media-wrapper">
                    <div class="footer-logo pl-4">
                        <picture>
                            <img
                                src={`${imagesurl}logo.svg`}
                                alt="Midnight Digital Logo"
                                width="145"
                                height="70"
                            />
                        </picture>
                    </div>
                    <div class="social-links">
                        <ul>
                            {
                                [
                                    "Facebook",
                                    "Instagram",
                                    "LinkedIn",
                                    "Twitter",
                                ].map((social) => (
                                    <li>
                                        <a href="#">
                                            {social}
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <>
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                                                </>
                                            </svg>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="copyright-text pl-4">
                        <p>
                            Copyright &copy; <b>Midnight</b>
                            {new Date().getFullYear()}
                        </p>
                    </div>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
        </div>
    </section>

    <FootScripts page="home" pagetype="onepage" />

    <script is:inline>
        // Reveal animation on scroll for .reveal-media elements
        document.addEventListener("DOMContentLoaded", function () {
            if (
                typeof gsap === "undefined" ||
                typeof ScrollTrigger === "undefined"
            )
                return;

            var elements = document.querySelectorAll(".reveal-media");
            if (!elements.length) return;

            elements.forEach(function (el) {
                gsap.set(el, {
                    clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                });

                gsap.to(el, {
                    clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                    duration: 1.2,
                    ease: "power3.inOut",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 80%",
                        once: true,
                    },
                });
            });
        });
    </script>

    <script is:inline>
        // Disable sticky on mobile - ScrollTrigger handles responsive
        (function () {
            if (typeof ScrollTrigger === "undefined") return;
            // Refresh ScrollTrigger after layout settles
            ScrollTrigger.refresh();
        })();
    </script>
</MainLayout>
