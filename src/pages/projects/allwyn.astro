---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import FootScripts from "../../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
    title="Allwyn | Midnight Digital Pvt Ltd"
    swiper={true}
    page="home"
    pagetype="onepage"
>
    <Header page="home" />

    <section class="section-casestudy-detail section-xs pb-2">
        <div class="custom-container-1840">
            <div class="grid-col-4 is-align-items-center">
                <div class="casstudy-detail-logo">
                    <picture>
                        <img
                            class="mb-0"
                            src={`${imagesurl}product/new-product/allwyn/logo1.webp`}
                            alt="Allwyn"
                            width="145"
                            height="70"
                        />
                    </picture>
                </div>
                <div
                    class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
                >
                    <h2 class="text-roll text-roll-single-line">Allwyn Chem Industries</h2>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="grid-col-2">
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
                >
                    <div
                        class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
                    >
                        <div class="theme-padding-xs section-xs">
                            <h3 class="mb-5 fw-500 line-reveal">
                                Project Overview
                            </h3>
                            <p class="has-text-justified line-reveal">
                                Allwyn Chem Industries is a Gujarat-based
                                manufacturer and exporter of starches, modified
                                starches, binders, gums, and specialty chemical
                                products.The website presents the company’s
                                industrial product portfolio, manufacturing
                                expertise, quality standards, certifications,
                                and customized solutions for multiple
                                industries.
                            </p>
                        </div>
                        <div class="is-relative">
                            <div class="theme-h-line"></div>
                            <div class="pb-0">
                                <div
                                    class="product-detail-block section-xs theme-padding-xs line-reveal"
                                >
                                    <h6>Technology Stack</h6>
                                    <ul
                                        class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                                    >
                                        <li>Figma (UI/UX Design)</li>
                                        <li>HTML5</li>
                                        <li>CSS3</li>
                                        <li>JavaScript</li>
                                        <li>PHP</li>
                                        <li>MySQL</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="theme-h-line"></div>
                        </div>
                    </div>
                </div>
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-right"
                >
                    <div class="case-study-image reveal-media">
                        <picture>
                            <img
                                src={`${imagesurl}product/new-product/allwyn/10.webp`}
                                alt="Case Study"
                                width="915"
                                height="815"
                            />
                        </picture>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-image pb-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="image-container">
                <picture>
                    <img
                        src={`${imagesurl}product/new-product/allwyn/banner2.webp`}
                        alt="Banner"
                        width="1920"
                        height="1080"
                    />
                </picture>
            </div>
        </div>
    </section>

    <section class="section-case-detail section-xs pb-0">
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="custom-container-1840">
            <div class="case-detail-layout">
                <!-- Left Side - Sticky -->
                <div class="case-detail-left section-xs theme-padding-xs">
                    <div class="section-title">
                        <h2 class="line-reveal">The Client</h2>
                    </div>
                    <div class="client-desc line-reveal">
                        <p>
                            Allwyn Chem Industries is a Gujarat-based
                            manufacturer and exporter of starches, modified
                            starches, binders, gums, and specialty chemical
                            products.It provides a business-focused digital
                            platform with product discovery, enquiry forms,
                            company information, careers, certifications, and
                            contact facilities.
                        </p>
                    </div>
                </div>

                <!-- Right Side - Scrollable -->
                <div class="case-detail-right">
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Core Requirements
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Establish a professional digital presence for a
                                chemical manufacturing company.
                            </li>
                            <li>
                                Present a large and diverse industrial product
                                portfolio.
                            </li>
                            <li>
                                Organize products into clear categories and
                                subcategories.
                            </li>
                            <li>
                                Provide easy access to detailed product
                                information.
                            </li>
                            <li>
                                Generate customer enquiries through dedicated
                                enquiry forms.
                            </li>
                            <li>
                                Showcase certifications and quality standards.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>

                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            The Solution
                        </h3>
                        <p class="line-reveal">
                            Developed a structured corporate website for Allwyn
                            Chem Industries Created a categorized product
                            architecture for easier navigation Added dedicated
                            pages for individual product categories Integrated a
                            prominent Enquire Now lead-generation flow Added
                            company values and quality-focused content Showcased
                            industry certifications and credentials Added office
                            and manufacturing-unit locations with map
                            integration.
                        </p>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Client Challenges
                        </h3>
                        <p class="line-reveal">
                           Presenting a wide range of technical products clearly:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                              Making complex industrial product categories easy to navigate.
                            </li>
                            <li>Building credibility for an international manufacturing business.</li>
                            <li>
                                Communicating technical expertise without overwhelming visitors.
                            </li>
                            <li>
                               Converting product visitors into business enquiries.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Challenges
                        </h3>
                        <p>
                            Structuring multiple product categories and subcategories:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                                Creating intuitive navigation for a large product portfolio.
                            </li>
                            <li>
                               Maintaining consistency across product pages.
                            </li>
                            <li>
                                Balancing technical information with a clean corporate presentation.
                            </li>
                            <li>
                                Creating an effective enquiry journey.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">Results</h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Created a professional digital presence for Allwyn Chem Industries.
                            </li>
                            <li>
                               Improved product discovery through structured categories.
                            </li>
                            <li>Established a clear pathway from product browsing to enquiry.</li>
                            <li>
                                Strengthened brand credibility through certifications and company values.
                            </li>
                            <li>Presented manufacturing capabilities and industrial expertise effectively.</li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Highlighted Features
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>Native & Modified Starch Product Categories</li>
                            <li>Paper & Packaging Adhesives</li>
                            <li>Dextrin & Specialty Starch Products</li>
                            <li>Cellulose & Chemical Products</li>
                            <li>Individual Product Pages</li>
                            <li>Enquire Now Lead Form</li>
                            <li>Company Values Section</li>
                            <li>Search & Filter Functionality</li>
                            <li>Office & Manufacturing Locations</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-footer section-xs pt-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="contact-us-title section-xs pb-0">
                <div class="section-title mb-0">
                    <h3 class="fw-500 is-uppercase font-orbitron pl-4">
                        Let's Talk
                    </h3>
                    <div class="theme-h-line"></div>
                </div>
                <div class="section-title pl-4">
                    <a href="/contact"><h2 class="text-roll">Contact Us</h2></a>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="footer-box">
                <div class="media-wrapper">
                    <div class="footer-logo pl-4">
                        <picture>
                            <img
                                src={`${imagesurl}logo.svg`}
                                alt="Midnight Digital Logo"
                                width="145"
                                height="70"
                            />
                        </picture>
                    </div>
                    <div class="social-links">
                        <ul>
                            {
                                [
                                    "Facebook",
                                    "Instagram",
                                    "LinkedIn",
                                    "Twitter",
                                ].map((social) => (
                                    <li>
                                        <a href="#">
                                            {social}
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <>
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                                                </>
                                            </svg>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="copyright-text pl-4">
                        <p>
                            Copyright &copy; <b>Midnight</b>
                            {new Date().getFullYear()}
                        </p>
                    </div>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
        </div>
    </section>

    <FootScripts page="home" pagetype="onepage" />

    <script is:inline>
        // Reveal animation on scroll for .reveal-media elements
        document.addEventListener("DOMContentLoaded", function () {
            if (
                typeof gsap === "undefined" ||
                typeof ScrollTrigger === "undefined"
            )
                return;

            var elements = document.querySelectorAll(".reveal-media");
            if (!elements.length) return;

            elements.forEach(function (el) {
                gsap.set(el, {
                    clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                });

                gsap.to(el, {
                    clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                    duration: 1.2,
                    ease: "power3.inOut",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 80%",
                        once: true,
                    },
                });
            });
        });
    </script>

    <script is:inline>
        // Disable sticky on mobile - ScrollTrigger handles responsive
        (function () {
            if (typeof ScrollTrigger === "undefined") return;
            // Refresh ScrollTrigger after layout settles
            ScrollTrigger.refresh();
        })();
    </script>
</MainLayout>
