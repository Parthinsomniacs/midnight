---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FootScripts from "../../components/FootScripts.astro";
import EnquiryPopup from "../../components/EnquiryPopup.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="Sankalp | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}product/new-product/sankalp/logo.svg`}
              alt="sankalp"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll text-roll-single-line">Sankalp Mobile App</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                Sankalp is a digital recovery and rehabilitation platform
                designed to support individuals struggling with drug and
                substance addiction.
              </p>
              <p>
                The platform focuses on helping users build a structured and
                disciplined lifestyle through a 90-day recovery journey. Users
                can track daily activities, monitor their progress, access
                health-related information, receive motivational content, and
                quickly access emergency support through the SOS feature.
              </p>
              <p>
                The core objective of Sankalp is to transform addiction recovery
                from an isolated process into a structured, trackable, and
                supportive digital experience.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Technology Stack</h6>
                  <ul
                    class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                  >
                    <li>Node.js</li>
                    <li>flutter</li>
                    <li>Android</li>
                    <li>MySQL</li>
                  </ul>
                </div>
              </div>
              <div class="theme-h-line"></div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}product/new-product/sankalp/12.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}product/new-product/sankalp/banner.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              Sankalp is a digital addiction recovery and rehabilitation
              initiative focused on helping individuals overcome substance
              addiction through structured guidance, daily activities, health
              awareness, and continuous motivation.
            </p>
            <p>
              The platform is designed to provide a supportive digital
              environment where users can follow their recovery journey, build
              healthier routines, and stay connected with the resources and
              support they need.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <ul class="list-point line-reveal">
              <li>
                Create a structured digital platform to support individuals
                throughout their addiction recovery journey.
              </li>
              <li>Provide a clear and engaging 90-day recovery program.</li>
              <li>
                Allow users to complete and track daily recovery activities.
              </li>
              <li>
                Provide health, awareness, and educational information in a
                simple format.
              </li>
              <li>
                Keep users motivated through progress tracking and meaningful
                content.
              </li>
              <li>
                Provide quick access to emergency assistance through the SOS
                feature.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <p class="line-reveal">
              We developed Sankalp, a digital recovery and rehabilitation
              platform designed to make the addiction recovery process more
              structured, accessible, and engaging.
            </p>
            <p>
              The platform brings daily activities, recovery progress, health
              information, motivational content, notifications, and emergency
              support together in one place. The 90-day journey gives users a
              clear structure to follow while visual progress helps them
              understand their progress and stay committed to their goals.
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Client Challenges</h3>
            <ul class="list-point line-reveal">
              <li>
                Creating a structured recovery experience that users can follow
                consistently.
              </li>
              <li>
                Keeping users engaged throughout the 90-day recovery journey.
              </li>
              <li>Making recovery progress easy to understand and track.</li>
              <li>
                Providing health and awareness information in an accessible
                format.
              </li>
              <li>Encouraging users to maintain positive daily routines.</li>
              <li>
                Providing immediate access to support during emergency
                situations.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>
            <p>
              One of the key challenges was designing a digital experience for
              users going through a sensitive and demanding recovery journey.
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>
            <ul class="list-point line-reveal">
              <li>
                AUsers can follow a clearly defined 90-day recovery program.
              </li>
              <li>
                Daily activities encourage discipline and healthier routines.
              </li>
              <li>
                Progress tracking gives users a clear view of their recovery
                journey.
              </li>
              <li>
                Health and awareness content provides valuable educational
                resources.
              </li>
              <li>
                Motivational content helps maintain engagement and consistency.
              </li>
              <li>
                The SOS feature provides quick access to emergency support.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">
              Highlighted Features
            </h3>
            <ul class="list-point line-reveal">
              <li>
                90-Day Recovery Journey â€“ A structured program that guides users
                through their recovery journey with clear progress milestones.
              </li>
              <li>
                Daily Activities â€“ Recovery-focused activities designed to
                encourage discipline, consistency, and positive daily habits.
              </li>
              <li>
                Progress Tracking â€“ Visual progress indicators help users
                understand their completed activities and overall journey
                progress.
              </li>
              <li>
                My Health â€“ Provides health-related information and educational
                resources to improve awareness and encourage healthier choices.
              </li>
              <li>
                Motivational Content â€“ Positive messages and recovery-focused
                content help users stay encouraged and committed.
              </li>
              <li>
                SOS Emergency Support â€“ A prominent emergency feature that
                allows users to quickly seek assistance when immediate support
                is required.
              </li>
              <li>
                Notifications & Reminders â€“ Keeps users informed about
                activities, important updates, and recovery-related reminders.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <script is:inline>
    // Disable sticky on mobile - ScrollTrigger handles responsive
    (function () {
      if (typeof ScrollTrigger === "undefined") return;
      // Refresh ScrollTrigger after layout settles
      ScrollTrigger.refresh();
    })();
  </script>

  <EnquiryPopup />
</MainLayout>
