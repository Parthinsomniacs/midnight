---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import FootScripts from "../../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
    title="Indian Future Typecon | Midnight Digital Pvt Ltd"
    swiper={true}
    page="home"
    pagetype="onepage"
>
    <Header page="home" />

    <section class="section-casestudy-detail section-xs pb-2">
        <div class="custom-container-1840">
            <div class="grid-col-4 is-align-items-center">
                <div class="casstudy-detail-logo">
                    <picture>
                        <img
                            class="mb-0"
                            src={`${imagesurl}product/new-product/uzeir/logo1.webp`}
                            alt="Uzeir"
                            width="145"
                            height="70"
                        />
                    </picture>
                </div>
                <div
                    class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
                >
                    <h2 class="text-roll">Indian Future Typecon</h2>
                </div>
                <div class="case-study-page-detail-social-icon">
                    <!-- Instagram -->
                    <a
                        href="https://www.instagram.com/indiasfuture.tycoons/"
                        target="_blank"
                        class="social-block"
                    >
                        <div class="social-icon-box">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                                ><path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"></path><path
                                    d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                                ></path><path
                                    d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                                ></path><path d="M16.5 7.5v.01"></path></svg
                            >
                        </div>
                        <div class="social-info">
                            <h5 class="social-name">Instagram</h5>
                            <span class="social-username">@runrkids</span>
                        </div>
                    </a>

                    <!-- facebook -->
                    <a
                        href="https://www.facebook.com/indiafuturetycoons"
                        target="_blank"
                        class="social-block"
                    >
                        <div class="social-icon-box">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                                ><path
                                    stroke="none"
                                    d="M0 0h24v24H0z"
                                    fill="none"></path><path
                                    d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                                ></path></svg
                            >
                        </div>
                        <div class="social-info">
                            <h5 class="social-name">facebook</h5>
                            <span class="social-username">@runrkids</span>
                        </div>
                    </a>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="grid-col-2">
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
                >
                    <div
                        class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
                    >
                        <div class="theme-padding-xs section-xs">
                            <h3 class="mb-5 fw-500 line-reveal">
                                Project Overview
                            </h3>
                            <p class="has-text-justified line-reveal">
                                India’s Future Tycoons (IFT) is a national
                                entrepreneurship and mentorship platform helping
                                students aged 13–18 turn ideas into real-world
                                ventures.The platform provides students with
                                design thinking, expert mentorship, bootcamps,
                                pitching opportunities, recognition and funding
                                pathways.
                            </p>
                        </div>
                        <div class="is-relative">
                            <div class="theme-h-line"></div>
                            <div class="pb-0">
                                <div
                                    class="product-detail-block section-xs theme-padding-xs line-reveal"
                                >
                                    <h6>Technology Stack</h6>
                                    <ul
                                        class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                                    >
                                        <li>Figma (UI/UX Design)</li>
                                        <li>HTML5</li>
                                        <li>CSS3</li>
                                        <li>JavaScript</li>
                                        <li>PHP</li>
                                        <li>MySQL</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="theme-h-line"></div>
                        </div>
                    </div>
                </div>
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-right"
                >
                    <div class="case-study-image reveal-media">
                        <picture>
                            <img
                                src={`${imagesurl}product/new-product/indian-future-typecon/14.webp`}
                                alt="Case Study"
                                width="915"
                                height="815"
                            />
                        </picture>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-image pb-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="image-container">
                <picture>
                    <img
                        src={`${imagesurl}product/new-product/indian-future-typecon/banner1.webp`}
                        alt="Banner"
                        width="1920"
                        height="1080"
                    />
                </picture>
            </div>
        </div>
    </section>

    <section class="section-case-detail section-xs pb-0">
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="custom-container-1840">
            <div class="case-detail-layout">
                <!-- Left Side - Sticky -->
                <div class="case-detail-left section-xs theme-padding-xs">
                    <div class="section-title">
                        <h2 class="line-reveal">The Client</h2>
                    </div>
                    <div class="client-desc line-reveal">
                        <p>
                            The website connects students, schools, mentors,
                            industry partners and investors through a structured
                            entrepreneurship journey and national innovation
                            platform.India’s Future Tycoons (IFT) is a national
                            entrepreneurship and mentorship platform helping
                            students aged 13–18 turn ideas into real-world
                            ventures.
                        </p>
                    </div>
                </div>

                <!-- Right Side - Scrollable -->
                <div class="case-detail-right">
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Core Requirements
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Build a national digital platform for young
                                entrepreneurs.
                            </li>
                            <li>
                                Enable students aged 13–18 to showcase
                                innovative ideas.
                            </li>
                            <li>
                                Create a structured entrepreneurship journey
                                from idea to pitch.
                            </li>
                            <li>
                                Connect students with industry mentors and
                                experts.
                            </li>
                            <li>
                                Provide schools with a platform for
                                future-skills development.
                            </li>
                            <li>
                                PrEnable partnerships with corporates and
                                organizations.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>

                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            The Solution
                        </h3>
                        <p class="line-reveal">
                            Developed a content-rich entrepreneurship platform
                            for young innovators Created dedicated journeys for
                            students and schools Structured the complete IFT
                            journey from registration to finaleCreated reward
                            and recognition sections for students, schools and
                            teachers Added enquiry flows for schools, mentors
                            and corporate partners.
                        </p>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Client Challenges
                        </h3>
                        <p class="line-reveal">
                            Engaging students, schools, mentors and corporate
                            partners on one platform:
                        </p>
                        <ul class="list-point line-reveal">
                            <li>
                                Presenting large amounts of educational and
                                program information effectively.
                            </li>
                            <li>
                                Building trust through industry experts and
                                successful participant stories.
                            </li>
                            <li>
                                Communicating a complex multi-stage program
                                clearly.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Challenges
                        </h3>
                        <p>Structuring a multi-stage entrepreneurship journey:</p>
                        <ul class="list-point line-reveal">
                            <li>
                                Managing multiple audience types with different objectives.
                            </li>
                            <li>
                                Presenting extensive mentor, jury and partner information.
                            </li>
                            <li>
                               Showcasing years of success stories and program outcomes.
                            </li>
                            <li>
                               Balancing educational content with an engaging youth-focused experience.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">Results</h3>
                        <ul class="list-point line-reveal">
                            <li>Established a strong national digital presence for IFT.</li>
                            <li>
                                Created a centralized platform for students, schools and partners.
                            </li>
                            <li>
                                Increased visibility of student success stories and achievements.
                            </li>
                            <li>
                                Created dedicated pathways for participation and partnership enquiries.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Highlighted Features
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>Student Registration & Idea Submission</li>
                            <li>School Registration / Enquiry</li>
                            <li>IFT Entrepreneurship Journey</li>
                            <li>Industry-Led Mentorship</li>
                            <li>Founders Bootcamp</li>
                            <li>National Pitch Platform</li>
                            <li>Expert Jury Showcase</li>
                            <li>Seed Funding & Awards</li>
                            <li>Mentor Network</li>
                            <li>Program Timeline</li>
                            <li>Rewards & Recognition Sections</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-footer section-xs pt-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="contact-us-title section-xs pb-0">
                <div class="section-title mb-0">
                    <h3 class="fw-500 is-uppercase font-orbitron pl-4">
                        Let's Talk
                    </h3>
                    <div class="theme-h-line"></div>
                </div>
                <div class="section-title pl-4">
                    <h2 class="text-roll">Contact Us</h2>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="footer-box">
                <div class="media-wrapper">
                    <div class="footer-logo pl-4">
                        <picture>
                            <img
                                src={`${imagesurl}logo.svg`}
                                alt="Midnight Digital Logo"
                                width="145"
                                height="70"
                            />
                        </picture>
                    </div>
                    <div class="social-links">
                        <ul>
                            {
                                [
                                    "Facebook",
                                    "Instagram",
                                    "LinkedIn",
                                    "Twitter",
                                ].map((social) => (
                                    <li>
                                        <a href="#">
                                            {social}
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <>
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                                                </>
                                            </svg>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="copyright-text pl-4">
                        <p>
                            Copyright &copy; <b>Midnight</b>
                            {new Date().getFullYear()}
                        </p>
                    </div>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
        </div>
    </section>

    <FootScripts page="home" pagetype="onepage" />

    <script is:inline>
        // Reveal animation on scroll for .reveal-media elements
        document.addEventListener("DOMContentLoaded", function () {
            if (
                typeof gsap === "undefined" ||
                typeof ScrollTrigger === "undefined"
            )
                return;

            var elements = document.querySelectorAll(".reveal-media");
            if (!elements.length) return;

            elements.forEach(function (el) {
                gsap.set(el, {
                    clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                });

                gsap.to(el, {
                    clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                    duration: 1.2,
                    ease: "power3.inOut",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 80%",
                        once: true,
                    },
                });
            });
        });
    </script>

    <script is:inline>
        // Disable sticky on mobile - ScrollTrigger handles responsive
        (function () {
            if (typeof ScrollTrigger === "undefined") return;
            // Refresh ScrollTrigger after layout settles
            ScrollTrigger.refresh();
        })();
    </script>
</MainLayout>
