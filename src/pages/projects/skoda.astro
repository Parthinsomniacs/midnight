---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import FootScripts from "../../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="Skoda | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}product/new-product/skoda/logo.svg`}
              alt="Alap"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll">Skoda</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                open to Boys Under-12 and Under 16 and Girls Under 16 wherein
                participants will get a chance to demonstrate their bowling and
                batting skills to a panel of National level selectors who will
                assign points to every ball batted and bowled. The competition
                will be held in 59 cities across India to identify the top
                performing cricketer from their respective categories.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Technology Stack</h6>
                  <ul
                    class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                  >
                    <li>node</li>
                    <li>flutter</li>
                    <li>Android</li>
                  </ul>
                </div>
              </div>
              <div class="theme-h-line"></div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}product/new-product/skoda/5.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}product/new-product/skoda/5.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>

    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>

          <div class="client-desc line-reveal">
            <p>
              ŠKODA AUTO India is a leading automotive brand that believes in
              creating meaningful experiences beyond mobility. Through ŠKODA
              Single Wicket, the brand extends this philosophy into cricket by
              supporting young talent and building stronger connections with the
              cricketing community.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <!-- Core Requirements -->
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>

            <ul class="list-point line-reveal">
              <li>
                Create a dedicated digital platform for ŠKODA Single Wicket.
              </li>
              <li>
                Introduce young players to the unique single-wicket format of
                cricket.
              </li>
              <li>
                Provide aspiring cricketers with an opportunity to showcase
                their individual skills.
              </li>
              <li>
                Create an engaging platform for cricket enthusiasts and
                participants.
              </li>
              <li>
                Strengthen the connection between ŠKODA AUTO India and the
                cricketing community.
              </li>
            </ul>
          </div>

          <div class="theme-h-line"></div>

          <!-- The Solution -->
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>

            <p class="line-reveal">
              We developed a dedicated digital experience for ŠKODA Single
              Wicket, bringing the tournament, its purpose, and its cricketing
              philosophy together in one platform.
            </p>

            <p class="line-reveal">
              The platform introduces users to the concept of single-wicket
              cricket while communicating ŠKODA's message, mission, and vision.
              It creates a strong digital identity for the initiative and gives
              young cricketers a space to discover, participate, and showcase
              their individual talent.
            </p>
          </div>

          <div class="theme-h-line"></div>

          <!-- Client Challenges -->
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Client Challenges</h3>

            <p class="line-reveal">
              The challenge was to communicate a relatively unique format of
              cricket in a simple and engaging way while positioning ŠKODA
              Single Wicket as an opportunity for young and aspiring players.
            </p>

            <ul class="list-point line-reveal">
              <li>
                Explaining the single-wicket cricket format to a wider audience.
              </li>
              <li>
                Communicating the initiative's message, mission, and vision
                clearly.
              </li>
              <li>
                Making the platform engaging for young cricket enthusiasts.
              </li>
              <li>Highlighting the individual nature of the competition.</li>
              <li>
                Creating a strong digital presence for the ŠKODA Single Wicket
                initiative.
              </li>
              <li>
                Connecting the brand's values with passion, talent, and cricket.
              </li>
            </ul>
          </div>

          <div class="theme-h-line"></div>

          <!-- Challenges -->
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>

            <p class="line-reveal">
              Single-wicket cricket is different from the traditional team-based
              format. The platform needed to communicate this difference while
              keeping the experience simple, informative, and engaging.
            </p>

            <ul class="list-point line-reveal">
              <li>Making a lesser-known cricket format easy to understand.</li>
              <li>
                Presenting the tournament as an individual showcase of talent.
              </li>
              <li>
                Balancing brand communication with an authentic cricket
                experience.
              </li>
              <li>
                Creating an experience that appeals to both young players and
                cricket enthusiasts.
              </li>
            </ul>
          </div>

          <div class="theme-h-line"></div>

          <!-- Results -->
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>

            <ul class="list-point line-reveal">
              <li>
                Created a dedicated digital identity for the ŠKODA Single Wicket
                initiative.
              </li>
              <li>
                Made the concept of single-wicket cricket easier for users to
                understand.
              </li>
              <li>
                Created a platform that communicates the brand's message,
                mission, and vision through cricket.
              </li>
              <li>
                Provided young and aspiring cricketers with a platform focused
                on individual talent and performance.
              </li>
              <li>
                Strengthened the connection between ŠKODA AUTO India, cricket,
                young talent, and the wider community.
              </li>
            </ul>
          </div>

          <div class="theme-h-line"></div>

          <!-- Highlighted Features -->
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">
              Highlighted Features
            </h3>

            <ul class="list-point line-reveal">
              <li>
                <strong>Single Wicket Cricket</strong> - Introduces users to a unique
                form of cricket where individual players compete against each other.
              </li>

              <li>
                <strong>Individual Talent Showcase</strong> - The format gives players
                an opportunity to demonstrate their individual batting and bowling
                abilities.
              </li>

              <li>
                <strong>Our Message</strong> - Communicates ŠKODA's vision of discovering
                and supporting the next generation of cricketing talent.
              </li>

              <li>
                <strong>Our Mission</strong> - Focuses on providing exciting opportunities
                for young and budding cricketers while creating an environment for
                participation, learning, and success.
              </li>

              <li>
                <strong>Our Vision</strong> - Aims to establish Single Wicket Cricket
                as a widely recognised and celebrated format of cricket across communities.
              </li>

              <li>
                <strong>Cricket Community</strong> - Creates a platform that brings
                young players, cricket enthusiasts, and the wider community together.
              </li>

              <li>
                <strong>Talent Discovery</strong> - Provides an opportunity for emerging
                players to get noticed and take their cricketing journey to the next
                level.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <h2 class="text-roll">Contact Us</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>
              Copyright &copy; <b>Midnight</b>
              {new Date().getFullYear()}
            </p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <script is:inline>
    // Disable sticky on mobile - ScrollTrigger handles responsive
    (function () {
      if (typeof ScrollTrigger === "undefined") return;
      // Refresh ScrollTrigger after layout settles
      ScrollTrigger.refresh();
    })();
  </script>
</MainLayout>
