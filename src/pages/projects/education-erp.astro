---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import FootScripts from "../../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
    title="Education ERP | Midnight Digital Pvt Ltd"
    swiper={true}
    page="home"
    pagetype="onepage"
>
    <Header page="home" />

    <section class="section-casestudy-detail section-xs pb-2">
        <div class="custom-container-1840">
            <div class="grid-col-4 is-align-items-center">
                <div class="casstudy-detail-logo"></div>
                <div
                    class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
                >
                    <h2 class="text-roll text-roll-single-line">Education ERP</h2>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="grid-col-2">
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
                >
                    <div
                        class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
                    >
                        <div class="theme-padding-xs section-xs">
                            <h3 class="mb-5 fw-500 line-reveal">
                                Project Overview
                            </h3>
                            <p class="has-text-justified line-reveal">
                                Lok Bharati ERP** is a comprehensive education
                                management and campus administration platform
                                designed to centralize and streamline the
                                day-to-day academic, administrative, and
                                operational activities of an educational
                                institution. The platform brings multiple
                                institutional functions into a unified digital
                                ecosystem, enabling administrators and academic
                                teams to manage examinations, teachers,
                                assignments, hostel operations, student-related
                                activities, reports, analytics, users, roles,
                                and institutional master data from a centralized
                                interface. The system is designed with a
                                structured, role-based architecture that
                                provides different users with access to relevant
                                modules and operational workflows. Its dashboard
                                provides management with a high-level view of
                                key institutional metrics, while individual
                                modules support detailed day-to-day execution.
                            </p>
                        </div>
                        <div class="is-relative">
                            <div class="theme-h-line"></div>
                            <div class="pb-0">
                                <div
                                    class="product-detail-block section-xs theme-padding-xs line-reveal"
                                >
                                    <h6>Technology Stack</h6>
                                    <ul
                                        class="list-point is-flex is-flex-wrap-wrap is-gap-4 mt-3"
                                    >
                                        <li>Web-Based ERP</li>
                                        <li>Mobile</li>
                                        <li>ERP v3.4</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="theme-h-line"></div>
                        </div>
                    </div>
                </div>
                <div
                    class="detai-page-wrapper rr-v-lines-none gray-bg border-right"
                >
                    <div class="case-study-image reveal-media">
                        <picture>
                            <img
                                src={`${imagesurl}product/new-product/education-erp/7.webp`}
                                alt="Case Study"
                                width="915"
                                height="815"
                            />
                        </picture>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-image pb-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="image-container">
                <picture>
                    <img
                        src={`${imagesurl}product/new-product/education-erp/banner.webp`}
                        alt="Banner"
                        width="1920"
                        height="1080"
                    />
                </picture>
            </div>
        </div>
    </section>

    <section class="section-case-detail section-xs pb-0">
        <div class="theme-h-line theme-outerline-left theme-outerline-right">
        </div>
        <div class="custom-container-1840">
            <div class="case-detail-layout">
                <!-- Left Side - Sticky -->
                <div class="case-detail-left section-xs theme-padding-xs">
                    <div class="section-title">
                        <h2 class="line-reveal">The Client</h2>
                    </div>
                    <div class="client-desc line-reveal">
                        <p>
                            Lok Bharati ERP establishes a **centralized digital
                            operating layer for educational institution
                            management**, connecting academic, examination,
                            faculty, assignment, hostel, reporting, analytics,
                            and administrative workflows within a unified
                            platform. Instead of managing individual processes
                            independently, institutional teams can access and
                            manage core operations through a single structured
                            system. This creates better operational visibility,
                            more organized data management, and a stronger
                            foundation for digital transformation across the
                            institution.
                        </p>
                    </div>
                </div>

                <!-- Right Side - Scrollable -->
                <div class="case-detail-right">
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Core Requirements
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Centralize academic and administrative
                                information.
                            </li>
                            <li>Digitize routine institutional workflows.</li>
                            <li>
                                Improve coordination between administrators,
                                teachers, and operational teams.
                            </li>
                            <li>
                                Simplify examination and academic management.
                            </li>
                            <li>
                                Organize teacher schedules, assignments, and
                                attendance-related activities.
                            </li>
                            <li>
                                Digitally manage hostel staff, rooms, assets,
                                and attendance.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>

                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            The Solution
                        </h3>
                        <p class="line-reveal">
                            Improving customer convenience and accessibility.
                            The centralized dashboard provides administrators
                            and management teams with a consolidated view of
                            institutional performance.The dashboard is designed
                            to convert operational data into actionable
                            information for institutional decision-making.The
                            dashboard is designed to convert operational data
                            into actionable information for institutional
                            decision-making.This helps academic teams maintain a
                            centralized record of assignments and assessment
                            activities.
                        </p>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Challenges
                        </h3>
                        <p>Centralized ERP Ecosystem.</p>
                        <ul class="list-point line-reveal">
                            <li>Key Product Highlights</li>
                            <li>Centralized ERP Ecosystem.</li>
                            <li>Digital Academic Operations.</li>
                            <li>Integrated Hostel Operations .</li>
                            <li>Structured Reporting.</li>
                            <li>Business & Operational Value.</li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">Results</h3>
                        <ul class="list-point line-reveal">
                            <li>
                                Reduce manual administrative effort. Improve
                                data accessibility. Minimize fragmented record
                                keeping. Standardize academic workflows.
                                Improve examination administration. Strengthen
                                faculty and assignment management. Simplify
                                hostel operations. Improve management
                                visibility. Support faster decision-making
                                through centralized insights. Create a
                                scalable foundation for future institutional
                                modules.
                            </li>
                        </ul>
                    </div>
                    <div class="theme-h-line"></div>
                    <div class="case-detail-block section-xs theme-padding-xs">
                        <h3 class="case-detail-heading line-reveal">
                            Highlighted Features
                        </h3>
                        <ul class="list-point line-reveal">
                            <li>Consistent navigation</li>
                            <li>Sidebar-based module organization</li>
                            <li>Tab-based workflows</li>
                            <li>Clear information hierarchy</li>
                            <li>Search and filtering</li>
                            <li>Export actions</li>
                            <li>Status indicators</li>
                            <li>Dashboard cards and visual analytics</li>
                            <li>Role and profile controls</li>
                            <li>Contextual actions for edit and delete operations</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-footer section-xs pt-0">
        <div class="theme-h-line theme-outerline-left"></div>
        <div class="container custom-container-1840">
            <div class="contact-us-title section-xs pb-0">
                <div class="section-title mb-0">
                    <h3 class="fw-500 is-uppercase font-orbitron pl-4">
                        Let's Talk
                    </h3>
                    <div class="theme-h-line"></div>
                </div>
                <div class="section-title pl-4">
                    <a href="/contact"><h2 class="text-roll">Contact Us</h2></a>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
            <div class="footer-box">
                <div class="media-wrapper">
                    <div class="footer-logo pl-4">
                        <picture>
                            <img
                                src={`${imagesurl}logo.svg`}
                                alt="Midnight Digital Logo"
                                width="145"
                                height="70"
                            />
                        </picture>
                    </div>
                    <div class="social-links">
                        <ul>
                            {
                                [
                                    "Facebook",
                                    "Instagram",
                                    "LinkedIn",
                                    "Twitter",
                                ].map((social) => (
                                    <li>
                                        <a href="#">
                                            {social}
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="24"
                                                height="24"
                                                viewBox="0 0 24 24"
                                                fill="currentColor"
                                            >
                                                <>
                                                    <path
                                                        stroke="none"
                                                        d="M0 0h24v24H0z"
                                                        fill="none"
                                                    />
                                                    <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                                                </>
                                            </svg>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="copyright-text pl-4">
                        <p>
                            Copyright &copy; <b>Midnight</b>
                            {new Date().getFullYear()}
                        </p>
                    </div>
                </div>
            </div>
            <div
                class="theme-h-line theme-outerline-left theme-outerline-right"
            >
            </div>
        </div>
    </section>

    <FootScripts page="home" pagetype="onepage" />

    <script is:inline>
        // Reveal animation on scroll for .reveal-media elements
        document.addEventListener("DOMContentLoaded", function () {
            if (
                typeof gsap === "undefined" ||
                typeof ScrollTrigger === "undefined"
            )
                return;

            var elements = document.querySelectorAll(".reveal-media");
            if (!elements.length) return;

            elements.forEach(function (el) {
                gsap.set(el, {
                    clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
                });

                gsap.to(el, {
                    clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                    duration: 1.2,
                    ease: "power3.inOut",
                    scrollTrigger: {
                        trigger: el,
                        start: "top 80%",
                        once: true,
                    },
                });
            });
        });
    </script>

    <script is:inline>
        // Disable sticky on mobile - ScrollTrigger handles responsive
        (function () {
            if (typeof ScrollTrigger === "undefined") return;
            // Refresh ScrollTrigger after layout settles
            ScrollTrigger.refresh();
        })();
    </script>
</MainLayout>
