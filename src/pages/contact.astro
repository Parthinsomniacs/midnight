---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="Case Study | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-contact p-0">
    <div class="container custom-container-1840">
      <div
        class="contact-us-title grid-col-3 section-xs pt-0 is-align-items-center pb-0"
      >
        <div class="theme-log">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}theme-icon-transparent.svg`}
              alt="Midnight Digital"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="contact-title-with-desc theme-padding-xs rr-h-line-none gray-bg section-xs border-right border-top"
        >
          <div class="section-title">
            <h2 class="text-roll">Let's Talk</h2>
          </div>
          <div class="contact-desc">
            <h5 class="line-reveal">
              We’d love to discuss your venture, and potential collaborations
              with Us. Let’s build something great together.
            </h5>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-3">
        <div class="social-detail">
          <!-- Facebook -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Facebook</h5>
              <span class="social-username">@midnightdigital</span>
            </div>
          </a>

          <!-- Instagram -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@midnightdigital</span>
            </div>
          </a>

          <!-- LinkedIn -->
          <a href="#" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M8 11v5"></path><path d="M8 8v.01"></path><path
                  d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"
                ></path><path
                  d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">LinkedIn</h5>
              <span class="social-username">@midnightdigital</span>
            </div>
          </a>
        </div>
        <div class="enqury-form rr-h-line-none gray-bg border-right">
          <div class="theme-padding-xs">
            <form class="contact-form" id="contactForm" novalidate>
              <div class="form-row">
                <div class="form-field">
                  <div class="form-box">
                    <label class="form-label">First Name*</label>
                    <input
                      type="text"
                      class="form-input"
                      name="fname"
                      placeholder="Enter first name"
                      required
                    />
                  </div>
                </div>
                <div class="form-field">
                  <div class="form-box">
                    <label class="form-label">Last Name*</label>
                    <input
                      type="text"
                      class="form-input"
                      name="lname"
                      placeholder="Enter last name"
                      required
                    />
                  </div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-field">
                  <div class="form-box">
                    <label class="form-label">Email*</label>
                    <input
                      type="email"
                      class="form-input"
                      name="email"
                      placeholder="Email"
                      required
                    />
                  </div>
                </div>
                <div class="form-field">
                  <div class="form-box">
                    <label class="form-label">Phone</label>
                    <input
                      type="tel"
                      class="form-input"
                      name="phone"
                      placeholder="Enter your phone number"
                      maxlength="10"
                    />
                  </div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-field full-width">
                  <div class="form-box">
                    <label class="form-label">Subject*</label>
                    <input
                      type="text"
                      class="form-input"
                      name="subject"
                      placeholder="The topic you want to talk"
                      required
                    />
                  </div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-field full-width">
                  <div class="form-box">
                    <label class="form-label">Message*</label>
                    <textarea
                      class="form-input form-textarea"
                      name="message"
                      placeholder="Write your message*"
                      rows="5"
                      required></textarea>
                  </div>
                </div>
              </div>
              <div class="form-row">
                <button type="submit" class="btn btn-submit">Submit Now</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <h2 class="text-roll">Contact Us</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>Copyright &copy; <b>Midnight</b> {new Date().getFullYear()}</p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Simple image reveal animation on scroll
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var images = document.querySelectorAll(".case-study-img img");
      if (!images.length) return;

      images.forEach(function (img) {
        gsap.set(img, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(img, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: img.closest(".case-study-img"),
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>
</MainLayout>
