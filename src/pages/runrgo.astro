---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import FootScripts from "../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="runrgo | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}case-study/all-case-study/runrgo/runr-go-logo.svg`}
              alt="Midnight Digital"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll">runrgo</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/runr.go/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                RunrGo is a comprehensive event management platform built for
                marathons, running communities, cycling events, and fitness
                challenges. The platform enables organizers to create, manage,
                and promote events while providing participants with a seamless
                registration and event experience.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="grid-col-1 pb-0 runrgo">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Frontend</h6>
                  <ul class="list-point">
                    <li>Next.js</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Backend</h6>
                  <ul class="list-point">
                    <li>Node.js</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Database</h6>
                  <p>MongoDB</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>CMS</h6>
                  <p>Custom Admin Panel</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image reveal-media">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/runrgo/runr-banner.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-client section-xs">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="grid-col-2">
        <div class="client-video rr-v-lines-none reveal-media">
          <video autoplay muted loop playsinline width="100%" height="100%">
            <source
              src={`${imagesurl}case-study/all-case-study/runr-kids/client-video.mp4`}
              type="video/mp4"
            />
          </video>
        </div>
        <div
          class="theme-padding-xs section-xs rr-v-lines-none gray-bg border-right"
        >
          <div class="section-title text-rev line-reveal">
            <h2>Services Provided</h2>
            <span class="title-tagline"
              >For this project, we delivered a complete eCommerce solution,
              including:</span
            >
          </div>
          <div class="client-desc">
            <ul class="list-point line-reveal">
              <li>UI/UX Design</li>
              <li>Website Design & Development</li>
              <li>Custom Event Management Platform</li>
              <li>Registration System Development</li>
              <li>Payment Gateway Integration</li>
              <li>Admin Panel Development</li>
              <li>API Integration</li>
              <li>Performance Optimization</li>
              <li>QA & Testing</li>
              <li>Deployment & Support</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-image pb-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="image-container">
        <picture>
          <img
            src={`${imagesurl}case-study/all-case-study/runrgo/runrgo.webp`}
            alt="Banner"
            width="1920"
            height="1080"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              RunrGo is a sports and fitness event platform that connects
              runners, cyclists, event organizers, and fitness enthusiasts
              through a centralized digital ecosystem. The client wanted an
              easy-to-use platform that could simplify event registrations,
              participant management, payments, and event promotion.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <ul class="list-point line-reveal">
              <li>Event listing platform</li>
              <li>Online event registration</li>
              <li>Secure payment integration</li>
              <li>Participant management</li>
              <li>Organizer dashboard</li>
              <li>Event categories</li>
              <li>Mobile responsive website</li>
              <li>User login & profile management</li>
              <li>Fast performance</li>
              <li>Scalable architecture</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <p class="line-reveal">
              The client was facing several operational challenges before
              digitizing the platform. We developed a comprehensive event
              management solution that addresses all key requirements.
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Client Challenges</h3>
            <p class="line-reveal">
              The client was facing several operational challenges before
              digitizing the platform:
            </p>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Challenges</h3>
            <ul class="list-point line-reveal">
              <li>Difficulty managing a large product catalog.</li>
              <li>Products were not organized properly into categories.</li>
              <li>
                Slow website performance affecting the shopping experience.
              </li>
              <li>Non-responsive design on mobile devices.</li>
              <li>Complex checkout process leading to cart abandonment.</li>
              <li>Need for secure online payment integration.</li>
              <li>Manual order and inventory management.</li>
              <li>Limited product search and filtering options.</li>
              <li>Poor user experience impacting customer engagement.</li>
              <li>
                Requirement for a scalable platform to support future growth.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Results</h3>
            <ul class="list-point line-reveal">
              <li>Faster website performance.</li>
              <li>Improved shopping experience across all devices.</li>
              <li>Easier product and inventory management.</li>
              <li>Secure and seamless online payments.</li>
              <li>
                Better customer engagement and higher conversion potential.
              </li>
              <li>
                A scalable platform capable of supporting business growth.
              </li>
              <li>SEO-optimized website structure</li>
              <li>Secure and scalable architecture</li>
            </ul>
          </div>
          <div class="theme-h-line"></div>
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">
              Highlighted Features
            </h3>
            <ul class="list-point line-reveal">
              <li>Event Discovery & Listings</li>
              <li>Online Registration</li>
              <li>Secure Payment Gateway</li>
              <li>Event Categories</li>
              <li>Participant Management</li>
              <li>User Login & Profile</li>
              <li>Responsive Confirmation</li>
              <li>Admin Management Panel</li>
              <li>SEO-Friendly Website</li>
              <li>Fast Performance</li>
              <li>Analytics & Reporting</li>
              <li>Third-Party Integration Tools</li>
              <li>Scalable Architecture</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <a href="/contact"><h2 class="text-roll">Contact Us</h2></a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>Copyright &copy; <b>Midnight</b> {new Date().getFullYear()}</p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>

  <script is:inline>
    // Disable sticky on mobile - ScrollTrigger handles responsive
    (function () {
      if (typeof ScrollTrigger === "undefined") return;
      // Refresh ScrollTrigger after layout settles
      ScrollTrigger.refresh();
    })();
  </script>
</MainLayout>
