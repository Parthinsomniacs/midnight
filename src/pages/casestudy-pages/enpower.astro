---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import FootScripts from "../../components/FootScripts.astro";

const imagesurl = "/media/images/";
---

<MainLayout
  title="IFT Enpower Hackathon | Midnight Digital Pvt Ltd"
  swiper={true}
  page="home"
  pagetype="onepage"
>
  <Header page="home" />

  <section class="section-casestudy-detail section-xs pb-2">
    <div class="custom-container-1840">
      <div class="grid-col-4 is-align-items-center">
        <div class="casstudy-detail-logo">
          <picture>
            <img
              class="mb-0"
              src={`${imagesurl}case-study/all-case-study/ift-india/enp-logo.webp`}
              alt="IFT Enpower Hackathon"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal"
        >
          <h2 class="text-roll">IFT Enpower</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/enpower.thinkcreatelead/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Instagram</h5>
              <span class="social-username">@runrkids</span>
            </div>
          </a>

          <!-- Linkdin -->
          <a
            href="https://in.linkedin.com/company/enlearning"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-linkedin"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M8 11v5"></path><path d="M8 8v.01"></path><path
                  d="M12 16v-5"></path><path d="M16 16v-3a2 2 0 1 0 -4 0"
                ></path><path
                  d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">LinkedIn</h5>
              <span class="social-username">@enlearning</span>
            </div>
          </a>

          <!-- Facebook -->
          <a
            href="https://www.facebook.com/Enpowerbschool/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-facebook"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3"
                ></path></svg
              >
            </div>
            <div class="social-info">
              <h5 class="social-name">Facebook</h5>
              <span class="social-username">@Enpowerbschool</span>
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>
              <p class="has-text-justified line-reveal">
                India's future tycoons is basically designed for hackathon
                competitions taking place in India. IFT is a SaaS based platform
                which helps organisations to conduct any kind of online
                competitions, collect submissions for it and announce results
                for the same, digitally powered by "Midnight E-hackathon".
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Platform</h6>
                  <ul class="list-point">
                    <li>Laravel</li>
                    <li>PHP</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Web Server</h6>
                  <p>Apache</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Programming Language</h6>
                  <p>PHP</p>
                </div>
              </div>
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Database</h6>
                  <p>MySQL</p>
                </div>

                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Development Tool</h6>
                  <p>Visual Studio</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Integration</h6>
                  <p>Send in Blue, Google Analytics</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg">
          <div class="case-study-image reveal-media p-3">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/ift-india/ift.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              According to the client, they are facing issues in managing things
              manually for such kinds of competitions. With their basic problem
              statement to make process automation and provide the system as
              transparent as possible for the students to gain faith in the
              system's ranking system and impartial standards, we were
              approached by them.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <p>
              Develop such a system where students can easily register and
              participate in these competitions. Registration process up to mark
              with authentications and validations making it possible to
              register as a team or individually.
            </p>
            <p>
              Clients must be able to create a jury panel, analyse submissions
              and shortlist students along with the ability to observe
              analytics.
            </p>
            <p>
              Students must be able to receive notifications and certificates
              related to the competitions, automatically.
            </p>
            <div class="mocup-img">
              <picture>
                <img
                  src={`${imagesurl}case-study/all-case-study/ift-india/mobile-mockup.webp`}
                  alt="Core Requirements"
                  width="915"
                  height="815"
                />
              </picture>
            </div>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <h6 class="fw-600 mb-5">Highlighted Features</h6>
            <div class="mb-3">
              <span class="mb-2 fw-600 d-block">Home page</span>
              <div class="solution-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/ift-india/1-laptop.webp`}
                    alt="Core Requirements"
                    width="820"
                    height="820"
                  />
                </picture>
              </div>
            </div>
            <div class="mb-3">
              <span class="mb-2 fw-600 d-block">Products</span>
              <div class="solution-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/ift-india/2-laptop.webp`}
                    alt="Core Requirements"
                    width="820"
                    height="820"
                  />
                </picture>
              </div>
            </div>
            <div class="mb-3">
              <span class="mb-2 fw-600 d-block">appointment</span>
              <div class="solution-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/ift-india/3-laptop.webp`}
                    alt="Core Requirements"
                    width="820"
                    height="820"
                  />
                </picture>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
          <div class="theme-h-line"></div>
        </div>
        <div class="section-title pl-4">
          <h2 class="text-roll">Contact Us</h2>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="footer-box">
        <div class="media-wrapper">
          <div class="footer-logo pl-4">
            <picture>
              <img
                src={`${imagesurl}logo.svg`}
                alt="Midnight Digital Logo"
                width="145"
                height="70"
              />
            </picture>
          </div>
          <div class="social-links">
            <ul>
              {
                ["Facebook", "Instagram", "LinkedIn", "Twitter"].map(
                  (social) => (
                    <li>
                      <a href="#">
                        {social}
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="24"
                          height="24"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <>
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M9.707 5.293l6 6a1 1 0 0 1 0 1.414l-6 6a1 1 0 1 1 -1.414 -1.414l5.293 -5.293l-5.293 -5.293a1 1 0 0 1 1.414 -1.414" />
                          </>
                        </svg>
                      </a>
                    </li>
                  ),
                )
              }
            </ul>
          </div>
          <div class="copyright-text pl-4">
            <p>Copyright &copy; <b>Midnight</b> {new Date().getFullYear()}</p>
          </div>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
    </div>
  </section>

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>
</MainLayout>
