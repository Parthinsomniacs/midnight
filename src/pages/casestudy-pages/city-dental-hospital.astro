  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              With the increasing demand for its services, the “city children
              hospital” recognised the need to establish an online presence to
              connect with the community and attract more patients. The hospital
              also wanted to provide online booking for appointments and
              facilitate secure communication between patients and healthcare
              providers.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <div class="mocup-img">
              <picture>
                <img
                  src={`${imagesurl}case-study/all-case-study/city-dental-hospital/edition.webp`}
                  alt="Core Requirements"
                  width="350"
                  height="410"
                />
              </picture>
            </div>
            <ul class="list-point">
              <li>
                Ability to view working hours of the hospital & book
                appointments.
              </li>
              <li>
                Ability to view dental problems & treatments provided for them.
              </li>
              <li>
                Ability to find the hospital easily through map directions.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <h6 class="fw-600 mb-5">Highlighted Features</h6>
            <div class="mb-3">
              <span class="mb-2 fw-600 d-block">Home page</span>
              <div class="solution-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/city-dental-hospital/1-laptop.webp`}
                    alt="Core Requirements"
                    width="820"
                    height="820"
                  />
                </picture>
              </div>
            </div>
            <div class="mb-3">
              <span class="mb-2 fw-600 d-block">Products</span>
              <div class="solution-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/city-dental-hospital/2-laptop.webp`}
