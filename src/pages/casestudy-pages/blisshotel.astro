              alt="IFT Enpower Hackathon"
              width="145"
              height="70"
            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal casestudy-detail-title"
        >
          <h2 class="text-roll">Hotel Bliss</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/blisshotel_/"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-instagram"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4l0 -8"
                ></path><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"
                ></path><path d="M16.5 7.5v.01"></path></svg
              >
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>

              <p>
                Hotel Bliss one of the best hotels located in the heart of the
                Bhavnagar city, close to the main market place and the different
                means of transport. It is extremely facilitating but lacks a
                digital exposure to make them easier to be found and letting the
                customers take advantage of such a standard quality hotel. This
                is when we started planning our journey to make them an eye
                catching easy to find website.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Platform</h6>
                  <ul class="list-point">
                    <li>Android, iOS,Web CMS</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Web Server</h6>
                  <p>Apache</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Programming Language</h6>
                  <ul class="list-point">
                    <li>Swift, Kotlin, C#</li>
                  </ul>
                </div>
              </div>
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Database</h6>
                  <p>MySQL</p>
                </div>

                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Development Tool</h6>
                  <ul class="list-point">
                    <li>Xcode,Android Studio,Visual Studio</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Integration</h6>
                  <p>Payment Gateway (Authorized.Net)</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image bharat-app reveal-media p-3">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/blisshotel/monitor.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

