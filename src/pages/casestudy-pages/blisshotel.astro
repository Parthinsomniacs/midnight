  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              Client wanted a website platform through which people looking for
              hotels can have an opportunity to view facilities provided along
              with the pricing and types of room available.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <div class="mocup-img">
              <picture>
                <img
                  src={`${imagesurl}case-study/all-case-study/blisshotel/edition.webp`}
                  alt="Core Requirements"
                  width="350"
                  height="410"
                />
              </picture>
            </div>
            <ul class="list-point">
              <li>
                Capable of providing hospital’s information regarding its
                services, facilities and healthcare professionals.
              </li>
              <li>
                Capable of providing prominent contact information along with
                working hours.
              </li>
              <li>
                Capable of allowing online booking at the patient’s convenience.
              </li>
              <li>
                Capable of collecting textual message queries along with the
                information to respond to the patient with a solution.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-footer section-xs pt-0">
    <div class="theme-h-line theme-outerline-left"></div>
    <div class="container custom-container-1840">
      <div class="contact-us-title section-xs pb-0">
        <div class="section-title mb-0">
          <h3 class="fw-500 is-uppercase font-orbitron pl-4">Let's Talk</h3>
