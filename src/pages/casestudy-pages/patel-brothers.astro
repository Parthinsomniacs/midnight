  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              Patel Brothers" is now being managed by their 2nd generation who
              are young, energetic and techno savvy. They came with a simple
              problem statement about improving their shopping experience and
              going digital. And we vowed to help evolve and innovate this
              experience with our solution.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <div class="mocup-img">
              <picture>
                <img
                  src={`${imagesurl}case-study/all-case-study/patel-brothers/edition.webp`}
                  alt="Core Requirements"
                  width="350"
                  height="410"
                />
              </picture>
            </div>
            <ul class="list-point">
              <li>
                Make a totally digital shopping experience for their customers.
              </li>
              <li>
                Built a hardcore backend to manage their inventory and other
                utilities.
              </li>
              <li>
                Seamless transition for their customers from viewing-add to
                car-purchase payment- delivery & tracking.
              </li>
              <li>
                Easy to use content management system for their products and
                orders to run smoothly.
              </li>
            </ul>
          </div>
          <div class="theme-h-line"></div>

          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">The Solution</h3>
            <h6 class="fw-600 mb-5">Highlighted Features</h6>
            <div class="mb-3">
              <span class="mb-2 fw-600 d-block">Home page</span>
              <div class="solution-img">
                <picture>
                  <img
                    src={`${imagesurl}case-study/all-case-study/patel-brothers/1-laptop.webp`}
