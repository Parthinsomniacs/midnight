            />
          </picture>
        </div>
        <div
          class="section-title theme-padding-xs mb-0 has-text-centered line-reveal casestudy-detail-title"
        >
          <h2 class="text-roll">Patel Brothers</h2>
        </div>
        <div class="case-study-page-detail-social-icon">
          <!-- Play Stor -->
          <a href="javascript:void(0)" target="_blank" class="social-block">
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-google-play"
                ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
                  d="M4 3.71v16.58a.7 .7 0 0 0 1.05 .606l14.622 -8.42a.55 .55 0 0 0 0 -.953l-14.622 -8.419a.7 .7 0 0 0 -1.05 .607l0 -.001"
                ></path><path d="M15 9l-10.5 11.5"></path><path
                  d="M4.5 3.5l10.5 11.5"></path></svg
              >
            </div>
          </a>
        </div>
      </div>
      <div class="theme-h-line theme-outerline-left theme-outerline-right">
      </div>
      <div class="grid-col-2">
        <div
          class="detai-page-wrapper rr-v-lines-none gray-bg border-left border-right"
        >
          <div
            class="h-100 is-flex is-flex-direction-column is-justify-content-space-between"
          >
            <div class="theme-padding-xs section-xs">
              <h3 class="mb-5 fw-500 line-reveal">Project Overview</h3>

              <p>
                “Patel Brothers” is a very well known grocery and gourmet seller
                in Bhavnagar. They started their journey with selling grains
                which now has augmented to selling pulses, dry fruits and almost
                all kinds of spices and condiments too, at their outlets in the
                city.
              </p>
              <p>
                Now they are looking to move their customers towards a mobile
                digital platform instead of having to visit their outlets with
                the aim to manage traffic and automate processes of stock
                management and order management. Here, we came into action and
                helped digitise the shopping and its management experience for
                them and their customers.
              </p>
            </div>
            <div class="is-relative">
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Platform</h6>
                  <ul class="list-point">
                    <li>Android, iOS</li>
                    <li>Flutter</li>
                    <li>Web CMS</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Web Server</h6>
                  <p>Apache</p>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Programming Language</h6>
                  <ul class="list-point">
                    <li>Dart</li>
                    <li>PHP</li>
                  </ul>
                </div>
              </div>
              <div class="theme-h-line"></div>
              <div class="product-detail pb-0">
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Database</h6>
                  <p>MySQL</p>
                </div>

                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Development Tool</h6>
                  <ul class="list-point">
                    <li>Android Studio</li>
                    <li>Visual Studio</li>
                  </ul>
                </div>
                <div
                  class="product-detail-block section-xs theme-padding-xs line-reveal"
                >
                  <h6>Integration</h6>
                  <ul class="list-point">
                    <li>Razor Pay</li>
                    <li>SMS</li>
                    <li>Firebase</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="detai-page-wrapper rr-v-lines-none gray-bg border-right">
          <div class="case-study-image bharat-app reveal-media p-3">
            <picture>
              <img
                src={`${imagesurl}case-study/all-case-study/patel-brothers/mobile-mockup.webp`}
                alt="Case Study"
                width="915"
                height="815"
              />
            </picture>
          </div>
        </div>
      </div>
    </div>
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
  </section>

