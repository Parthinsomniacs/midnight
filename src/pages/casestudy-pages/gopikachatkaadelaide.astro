  <section class="section-case-detail section-xs pb-0">
    <div class="theme-h-line theme-outerline-left theme-outerline-right"></div>
    <div class="custom-container-1840">
      <div class="case-detail-layout">
        <!-- Left Side - Sticky -->
        <div class="case-detail-left section-xs theme-padding-xs">
          <div class="section-title">
            <h2 class="line-reveal">The Client</h2>
          </div>
          <div class="client-desc line-reveal">
            <p>
              The client desired a website that would represent and display
              dishes, its rates and listing all its outlets for food enthusiasts
              so they can navigate and reach the outlet without problem.
            </p>
          </div>
        </div>

        <!-- Right Side - Scrollable -->
        <div class="case-detail-right">
          <div class="case-detail-block section-xs theme-padding-xs">
            <h3 class="case-detail-heading line-reveal">Core Requirements</h3>
            <div class="mocup-img">
              <picture>
                <img
                  src={`${imagesurl}case-study/all-case-study/gopikachatkaadelaide/edition.webp`}
                  alt="Core Requirements"
                  width="350"
                  height="410"
                />
              </picture>
            </div>
            <ul class="list-point">
              <li>
                Websites must be able to handle and manage traffic, maintaining
                smooth access and navigation.
              </li>
              <li>
                Provide working hours, contact and outlet details on the site.
              </li>
              <li>
                Make the website visually appealing and easy to find on the
                search engine.
              </li>
              <li>
                Provide menu information on their dishes as well as the prices
                for each.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <FootScripts page="home" pagetype="onepage" />

  <script is:inline>
    // Reveal animation on scroll for .reveal-media elements
    document.addEventListener("DOMContentLoaded", function () {
      if (typeof gsap === "undefined" || typeof ScrollTrigger === "undefined")
        return;

      var elements = document.querySelectorAll(".reveal-media");
      if (!elements.length) return;

      elements.forEach(function (el) {
        gsap.set(el, {
          clipPath: "polygon(0% 0%, 0% 0%, 0% 100%, 0% 100%)",
        });

        gsap.to(el, {
          clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
          duration: 1.2,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            once: true,
          },
        });
      });
    });
  </script>
</MainLayout>
