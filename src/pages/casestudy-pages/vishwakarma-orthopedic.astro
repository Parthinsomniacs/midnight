                ></path></svg
              >
            </div>
          </a>
          <!-- Twitter -->
          <a
            href="#"
            target="_blank"
            class="social-block"
          >
            <div class="social-icon-box">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-brand-x"
